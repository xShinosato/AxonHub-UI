local function b64decode(s)
	local ok, r = pcall(function()
		return (crypt and crypt.base64decode and crypt.base64decode(s))
			or (crypt and crypt.base64 and crypt.base64.decode and crypt.base64.decode(s))
			or (base64_decode and base64_decode(s))
			or (base64 and base64.decode and base64.decode(s))
	end)
	if ok and type(r) == "string" and #r > 0 then return r end
	local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	local map = {}
	for i = 1, 64 do map[alphabet:byte(i)] = i - 1 end
	local out, acc, bits = {}, 0, 0
	for i = 1, #s do
		local v = map[s:byte(i)]
		if v then
			acc = acc * 64 + v
			bits += 6
			if bits >= 8 then
				bits -= 8
				local byte = math.floor(acc / 2 ^ bits)
				out[#out + 1] = string.char(byte)
				acc -= byte * 2 ^ bits
			end
		end
	end
	return table.concat(out)
end

local assetCache = {}
local function customAsset(name, data)
	if assetCache[name] ~= nil then return assetCache[name] or nil end
	local result = false
	pcall(function()
		local gca = getcustomasset or getsynasset
		if not (gca and writefile and data and data ~= "") then return end
		ensureFolder(Library.Folder)
		ensureFolder(Library.Folder .. "/assets")
		local path = Library.Folder .. "/assets/" .. name
		if not (isfile and isfile(path)) then writefile(path, b64decode(data)) end
		result = gca(path)
	end)
	assetCache[name] = result
	return result or nil
end
