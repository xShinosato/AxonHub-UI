				tw(fscale, 0.35, { Scale = 1 }, Back)
				if not moved then setVisible(not Window.Visible) end
			end
		end)
		Window._anchor = function()
			if not fb.Visible then return nil end
			return fb.AbsolutePosition + fb.AbsoluteSize / 2
		end
		floatBtn = { Refresh = function()
			local show = isTouch or not Window.Visible
			if show and not fb.Visible then
				fb.Visible = true
				fscale.Scale = 0.4
				tw(fscale, 0.45, { Scale = 1 }, Back)
