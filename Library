			local t1 = new("TextLabel", { Text = tostring(d.Title or "Server"), FontFace = body(W_SEMI), TextSize = 14, Size = UDim2.new(1, 0, 0, 17), TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 58, Parent = col })
			local t2 = new("TextLabel", { Text = tostring(d.Description or ""), TextSize = 12, TextColor3 = T.Sub, Size = UDim2.new(1, 0, 0, 14 * (1 + extra)), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = 2, ZIndex = 58, Parent = col })
