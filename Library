	-- Tabs
	local current
	local tabCount = 0

	local tabRows, groupLabels = {}, {}
	local dense = false
	local function tabH() return dense and (compact and 32 or 30) or TAB_H end
	local function applyDensity()
		local vis = L_.vis
		for _, b in ipairs(tabRows) do b.Size = UDim2.new(1, 0, 0, tabH()) end
		menuRow.Size = UDim2.new(1, 0, 0, tabH())
		for i, lbl in ipairs(groupLabels) do
			local h
			if vis == "rail" then h = i == 1 and 0 or SP.Group
			elseif vis == "narrow" then h = i == 1 and (dense and 14 or 16) or (dense and 20 or 22)
			else h = i == 1 and (dense and 16 or 20) or (dense and 22 or 28) end
			lbl.Size = UDim2.new(1, 0, 0, h)
			lbl.TextTransparency = vis == "rail" and 1 or 0
			lbl.TextSize = vis == "narrow" and 10 or 11
		end
		indicator.Size = UDim2.new(1, 0, 0, tabH())
	end
	table.insert(navHooks, function()
		dense = false
		applyDensity()
	end)
	local function fitSidebar()
		local s = Window._scale or 1
		local need = (tabInner.AbsoluteSize.Y) / s
		local room = tabScroll.AbsoluteSize.Y / s
		if not dense and need > room + 0.5 and room > 0 then
			dense = true
			applyDensity()
		end
		local overflow = tabInner.AbsoluteSize.Y > tabScroll.AbsoluteSize.Y + 0.5
		tabScroll.ScrollBarThickness = overflow and 2 or 0
		if not overflow then tabScroll.CanvasPosition = Vector2.zero end
	end
	tabInner:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitSidebar)
	tabScroll:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitSidebar)
	paint(tabScroll, "ScrollBarImageColor3")
	tabScroll.ScrollBarImageTransparency = 0.5
	tabScroll.VerticalScrollBarInset = Enum.ScrollBarInset.None

	local function liveScale() return math.max(0.01, scale.Scale) end
	local function keepTabInView(tab)
		local s = liveScale()
		local top = (tab.Button.AbsolutePosition.Y - tabScroll.AbsolutePosition.Y) / s
		local bottom = top + tab.Button.AbsoluteSize.Y / s
		local view = tabScroll.AbsoluteSize.Y / s
		local y = tabScroll.CanvasPosition.Y
		if top < SIDE_PAD then y += top - SIDE_PAD elseif bottom > view - SIDE_PAD then y += bottom - view + SIDE_PAD else return end
		tw(tabScroll, 0.35, { CanvasPosition = Vector2.new(0, math.max(0, y)) })
	end

	local function moveIndicator(tab, instant)
		local y = (tab.Button.AbsolutePosition.Y - tabList.AbsolutePosition.Y) / liveScale()
		local on_ = 1 - GL.Control[1]
		if instant then
