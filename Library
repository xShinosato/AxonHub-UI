-- Animation loop
local animators = {}
local clock = 0
local function animate(fn, guard)
	local entry = { fn = fn, guard = guard }
	table.insert(animators, entry)
	return function() table.remove(animators, table.find(animators, entry) or 0) end
end
on(RunService.RenderStepped, function(dt)
	clock += dt
	for i = #animators, 1, -1 do
		local a = animators[i]
		if a and (not a.guard or a.guard()) then
			local ok = pcall(a.fn, clock, dt)
			if not ok then table.remove(animators, i) end
		end
	end
end)

-- Drag bus
local activeDrag
local function beginDrag(onMove, onEnd)
	if activeDrag and activeDrag.finish then pcall(activeDrag.finish) end
	activeDrag = { move = onMove, finish = onEnd }
end
on(UserInputService.InputChanged, function(input)
	if activeDrag and isMove(input) then activeDrag.move(input) end
end)
on(UserInputService.InputEnded, function(input)
	if activeDrag and isPress(input) then
		local d = activeDrag
		activeDrag = nil
		if d.finish then d.finish(input) end
	end
end)

