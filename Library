		local GAP, PW = 10, 320
		SB.side = "right"
		local function place()
			if not dock then return end
			local s_ = Window._scale or 1
			local vp = viewport()
			local x0, x1 = root.AbsolutePosition.X, root.AbsolutePosition.X + root.AbsoluteSize.X
			local need = (GAP + PW) * s_ + 8
			if x1 + need <= vp.X then SB.side = "right"
			elseif x0 - need >= 0 then SB.side = "left"
			else SB.side = "inside" end
			if SB.side == "inside" then
				local w = root.Size.X.Offset
				dock.AnchorPoint = Vector2.new(1, 0)
				dock.Size = UDim2.new(0, math.min(PW, w - 16), 1, -16)
			else
				dock.AnchorPoint = Vector2.new(SB.side == "right" and 0 or 1, 0)
				dock.Size = UDim2.new(0, PW, 1, 0)
			end
		end
		local function restPos()
			if SB.side == "right" then return UDim2.new(1, GAP, 0, 0)
			elseif SB.side == "left" then return UDim2.new(0, -GAP, 0, 0) end
			return UDim2.new(1, -8, 0, 8)
		end
		local function awayPos()
			if SB.side == "right" then return UDim2.new(1, GAP - 24, 0, 0)
			elseif SB.side == "left" then return UDim2.new(0, -GAP + 24, 0, 0) end
			return UDim2.new(1, 16, 0, 8)
		end

