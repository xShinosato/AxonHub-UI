local function makeSignal()
	local fns = {}
	local sig = {}
	function sig:Connect(fn)
		table.insert(fns, fn)
		return { Disconnect = function() table.remove(fns, table.find(fns, fn) or 0) end }
	end
	function sig:Fire(...)
		for _, fn in ipairs(fns) do task.spawn(pcall, fn, ...) end
	end
	return sig
end
Library.OnUnload = makeSignal()

