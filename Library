				new("Frame", { Size = UDim2.new(1, -4, 0.5, -2), Position = UDim2.fromOffset(2, 2), BackgroundColor3 = WHITE, BackgroundTransparency = 0, ZIndex = 59, Parent = jf }, { corner(R.Control - 2), gradient({ Rotation = 90, Transparency = seq(0.8, 1) }) })
