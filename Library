local function urlAsset(url, done)
	local key = url:gsub("[^%w]", ""):sub(-40)
	if assetCache[key] ~= nil then done(assetCache[key] or nil) return end
	task.spawn(function()
		local result = false
		pcall(function()
			local gca = getcustomasset or getsynasset
			if not (gca and writefile) then return end
			ensureFolder(Library.Folder)
			ensureFolder(Library.Folder .. "/images")
			local ext = url:lower():match("%.(%a+)$")
			ext = (ext == "jpg" or ext == "jpeg") and ext or "png"
			local path = Library.Folder .. "/images/" .. key .. "." .. ext
			if not (isfile and isfile(path)) then
				local body = game:HttpGet(url)
				if type(body) ~= "string" or #body < 16 then return end
				writefile(path, body)
			end
			result = gca(path)
		end)
		assetCache[key] = result
		done(result or nil)
	end)
end
local function resolveImage(v, depth)
	depth = depth or 0
	if depth > 4 or v == nil then return nil end
	if type(v) == "table" then
		local src, tint = resolveImage(v.Image or v.Id or v.Url or v[1], depth + 1)
		return src, v.Tint == true or tint
	end
	if type(v) == "number" then return "rbxassetid://" .. tostring(math.floor(v)), false end
	if type(v) ~= "string" or v == "" then return nil end
	if v:match("^%d+$") then return "rbxassetid://" .. v, false end
	if v:match("^rbxasset") or v:match("^rbxthumb") or v:match("^https?://") then return v, false end
	local named = Library.Images[v]
	if named ~= nil then return resolveImage(named, depth + 1) end
	return nil
end
function Library:AddImages(map)
	for name, v in pairs(map or {}) do Library.Images[name] = v end
	return self
end
