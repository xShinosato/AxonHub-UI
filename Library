	local function setVisible(v, instant)
		if v == Window.Visible and revealed then return end
		Window.Visible = v
		if not v and Window._onHide then pcall(Window._onHide) end
		animId += 1
		local id = animId
		local s = Window._scale or 1
		if v then
			local first = not revealed
			revealed = true
			root.Visible = true
			local home = homePos or root.Position
			homePos = home
			opening = true
			if blur then tw(blur, 0.45, { Size = 14 }) end
			if instant then
				exitGroup()
				root.Position, scale.Scale = home, s
				opening = false
			else
				enterGroup()
				if Window._prebuild then Window._prebuild() end
				local final = screenCenter(home)
				local size = root.AbsoluteSize / scale.Scale * s
				if first then
					root.Position = home
					scale.Scale = s * 0.9
					fadeGroup.GroupTransparency = 1
					tw(scale, 0.5, { Scale = s }, Back)
					tw(fadeGroup, 0.3, { GroupTransparency = 0 })
					if Window._build then Window._build(0.08) end
				else
					local from = toggleAnchor()
					root.Position = UDim2.fromOffset(from.X, from.Y)
					scale.Scale = s * TINY / math.max(1, root.Size.X.Offset)
					fadeGroup.GroupTransparency = 1
					local info = TweenInfo.new(OPEN_T, Quint, Enum.EasingDirection.Out)
					TweenService:Create(root, info, { Position = home }):Play()
					TweenService:Create(scale, info, { Scale = s }):Play()
					TweenService:Create(fadeGroup, TweenInfo.new(OPEN_T * 0.7, Quint, Enum.EasingDirection.Out), { GroupTransparency = 0 }):Play()
					if Window._build then Window._build(OPEN_T * 0.35) end
				end
				task.delay(0.65, function()
					if id == animId and Window.Visible then
						exitGroup()
						root.Position, scale.Scale = home, s
						opening = false
						if Window._settleTabs then Window._settleTabs() end
					end
				end)
			end
		else
			revealed = true
			if Window._finishBuild then Window._finishBuild() end
			if blur then tw(blur, 0.3, { Size = 0 }) end
			if not opening or not homePos then homePos = root.Position end
			opening = false
			local home = homePos
			if instant then
				root.Visible = false
			else
				enterGroup()
				local to = toggleAnchor()
				local info = TweenInfo.new(CLOSE_T, Quint, Enum.EasingDirection.In)
				TweenService:Create(root, info, { Position = UDim2.fromOffset(to.X, to.Y) }):Play()
				TweenService:Create(scale, info, { Scale = s * TINY / math.max(1, root.Size.X.Offset) }):Play()
				TweenService:Create(fadeGroup, info, { GroupTransparency = 1 }):Play()
				task.delay(CLOSE_T, function() if id == animId then landing(to) end end)
				task.delay(CLOSE_T + 0.02, function()
					if id ~= animId or Window.Visible then return end
					root.Visible = false
					exitGroup()
					scale.Scale = s
					root.Position = home
				end)
			end
		end
		if floatBtn then floatBtn.Refresh(instant) end
	end
