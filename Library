		eyeBtn.InputEnded:Connect(function(input) if isPress(input) then tw(eyeScale, 0.35, { Scale = 1 }, Back) end end)
		eyeBtn.Activated:Connect(function() setVisible(not Window.Visible) end)

		task.defer(function()
			setExpanded(true, true)
			task.delay(opts.Splash == false and 0.1 or 1.9, function()
				tw(sb, 0.6, { Position = UDim2.new(1, X, 0, 14) }, Back)
			end)
		end)
		Window._anchor = function()
			return eyeBtn.AbsolutePosition + eyeBtn.AbsoluteSize / 2
		end
		local eyeSeq = 0
		floatBtn = { Refresh = function(instant)
			eyeSeq += 1
			local seq, visible = eyeSeq, Window.Visible
			local delayT = (visible or instant) and 0 or 0.34
			local function paint_()
				tw(eyeBtn, 0.25, { BackgroundColor3 = visible and WHITE or T.Accent, BackgroundTransparency = visible and (1 - GL.Control[1]) or 0.15 })
				tw(eyeStroke, 0.25, { Transparency = visible and GL.Control[2] or 0.6 })
				tw(eye, 0.25, { ImageColor3 = visible and T.Sub or WHITE })
			end
			if instant then setIcon(eye, visible and "eye" or "eye-off") paint_() return end
			-- the icon flips: squashes shut, swaps, opens again
			tw(eye, 0.12, { Size = UDim2.fromOffset(15, 1) }, Quad, Enum.EasingDirection.In)
			task.delay(math.max(0.12, delayT), function()
				if seq ~= eyeSeq then return end
				setIcon(eye, visible and "eye" or "eye-off")
				tw(eye, 0.3, { Size = UDim2.fromOffset(15, 15) }, Back)
				paint_()
				eyeScale.Scale = visible and 0.85 or 1.3
				tw(eyeScale, 0.45, { Scale = 1 }, Back)
			end)
		end }
	elseif opts.ToggleButton ~= false then
		local fb = new("TextButton", {
			Name = "AxonToggle", Text = "", AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0, 46, 0, GuiService:GetGuiInset().Y + 46), Size = UDim2.fromOffset(46, 46),
			ZIndex = 90, Visible = false, Parent = Screen,
		})
		darkGlass(fb, R.Window, 0.1)
		local fscale = new("UIScale", { Parent = fb })
		logo(fb, 28, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = 91 })
		local downAt, moved, startPos
		fb.InputBegan:Connect(function(input)
			if isPress(input) then
				downAt, moved, startPos = input.Position, false, fb.Position
				tw(fscale, 0.15, { Scale = 0.92 })
			end
		end)
		on(UserInputService.InputChanged, function(input)
			if downAt and isMove(input) then
				local d = input.Position - downAt
				if d.Magnitude > 6 then moved = true end
				if moved then fb.Position = UDim2.new(0, startPos.X.Offset + d.X, 0, startPos.Y.Offset + d.Y) end
