			function S:CreateSlider(a, b)
				local flag, o = norm(a, b)
				local min, max = tonumber(o.Min) or 0, tonumber(o.Max) or 100
				local decimals = tonumber(o.Rounding)
				local step = tonumber(o.Increment or o.Step)
				local prefix, suffix = o.Prefix or "", o.Suffix or ""
				local THUMB, TRACK = 14, 6
				local HALF = THUMB / 2

				local holder = new("Frame", { Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = WHITE, BackgroundTransparency = 1, LayoutOrder = nextOrder(), Parent = items }, { corner(R.Control), pad(7, SP.Text, 7, SP.Text) })
				local t1 = new("TextLabel", {
					Text = tostring(o.Title or o.Name or "Slider"), TextSize = 14, TextTransparency = 0.15,
					Size = UDim2.new(1, -84, 0, 18), TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = holder,
				})
				local valueBox = new("TextBox", {
					Text = "", FontFace = body(W_SEMI), TextSize = 13, TextColor3 = T.Sub, ClearTextOnFocus = false,
					AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromOffset(80, 18),
					TextXAlignment = Enum.TextXAlignment.Right, ClipsDescendants = true, Parent = holder,
				})
				local valueScale = new("UIScale", { Parent = valueBox })
				local area = new("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, THUMB), BackgroundTransparency = 1, Parent = holder })
				local track = new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(1, 0, 0, TRACK), Parent = area })
				local trackStroke = glass(track, TRACK / 2, 0.09, 0.84)
				local fill = new("Frame", { Size = UDim2.new(0, HALF, 1, 0), BackgroundColor3 = WHITE, Parent = track }, { round() })
				paint(gradient({ Rotation = 0, Parent = fill }), "Color", "seq")
				local gloss = new("Frame", { Size = UDim2.new(1, 0, 0.5, 0), BackgroundColor3 = WHITE, BackgroundTransparency = 0.55, Parent = fill }, { round() })
				local shine = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, Parent = fill }, { round() })
				local shineGrad = gradient({
					Transparency = NumberSequence.new({ kp(0, 1), kp(0.4, 1), kp(0.5, 0.6), kp(0.6, 1), kp(1, 1) }),
					Offset = Vector2.new(-1, 0), Parent = shine,
				})
				local unShine = addFx(function(t)
					local u = (t % 4) / 1.6
					if u > 1 then shineGrad.Offset = Vector2.new(-1, 0) return end
					shineGrad.Offset = Vector2.new(-1 + 2 * (0.5 - math.cos(u * math.pi) / 2), 0)
				end)
				local thumb = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, HALF, 0.5, 0), Size = UDim2.fromOffset(THUMB, THUMB), BackgroundColor3 = WHITE, ZIndex = 3, Parent = area }, { round() })
				gradient({ Rotation = 90, Color = ColorSequence.new(WHITE, rgb(222, 214, 238)), Parent = thumb })
				new("UIStroke", { Color = Color3.new(0, 0, 0), Transparency = 0.75, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = thumb })
				local thumbScale = new("UIScale", { Parent = thumb })
				local hit = new("TextButton", { Text = "", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1, ZIndex = 5, Parent = area })

				local el = element("Slider", flag, holder, o, t1, nil)
				local function round_(v)
					local d = decimals
					if not d then d = math.abs(v) >= 10 and 0 or 2 end
					local m = 10 ^ d
					return math.floor(v * m + 0.5) / m, d
				end
				local function fmt(v)
					local r, d = round_(v)
					local s = d > 0 and string.format("%." .. d .. "f", r) or tostring(math.floor(r + 0.5))
					if not decimals and d > 0 then s = tostring(tonumber(s)) end
					return prefix .. s .. suffix
				end
				local function snap(v)
					v = math.clamp(v, min, max)
					if step and step > 0 then v = min + math.floor((v - min) / step + 0.5) * step end
					return math.clamp((round_(v)), min, max)
				end
				local function pct(v) return (max > min) and math.clamp((v - min) / (max - min), 0, 1) or 0 end
				local function at(p) return HALF - THUMB * p end
				local dragging, hovering = false, false
				local function render(v)
					local p = pct(v)
					local t, style = 0.3, Quint
					if dragging then t, style = 0.08, Quad end
					tw(fill, t, { Size = UDim2.new(p, at(p), 1, 0) }, style)
					tw(thumb, t, { Position = UDim2.new(p, at(p), 0.5, 0) }, style)
					if not valueBox:IsFocused() then valueBox.Text = fmt(v) end
				end
				function el:SetValue(v, silent)
					v = snap(tonumber(v) or min)
					local changed = v ~= self.Value
					self.Value = v
					render(v)
					if changed then
						if not silent then spawnSafe(o.Callback, v) end
						self:_fire(v)
					end
					return self
				end
				function el:SetMin(v) min = v self:SetValue(self.Value) end
				function el:SetMax(v) max = v self:SetValue(self.Value) end
				el._serialize = function(self) return self.Value end
				el._deserialize = function(self, v) self:SetValue(v) end
				el._onDisabled = function(d)
					tw(thumb, 0.2, { BackgroundTransparency = d and 0.5 or 0 })
					tw(fill, 0.2, { BackgroundTransparency = d and 0.6 or 0 })
				end

				-- states: rest -> hover -> pressed, and back
				local function state()
					local s = dragging and 2 or (hovering and not el.Disabled) and 1 or 0
					tw(t1, 0.2, { TextTransparency = s > 0 and 0 or 0.15 })
					tw(holder, 0.25, { BackgroundTransparency = s > 0 and 0.975 or 1 })
					tw(trackStroke, 0.2, { Transparency = s > 0 and 0.7 or 0.84 })
					tw(thumbScale, 0.35, { Scale = s == 1 and 1.12 or 1 }, Back)
					tw(thumb, 0.35, { Size = UDim2.fromOffset(s == 2 and THUMB + 8 or THUMB, THUMB) }, Back)
					tw(track, 0.25, { Size = UDim2.new(1, 0, 0, s == 2 and TRACK + 2 or TRACK) })
					tw(gloss, 0.25, { BackgroundTransparency = s == 2 and 0.35 or 0.55 })
					tw(valueBox, 0.2, { TextColor3 = s == 2 and T.Accent2 or (s == 1 and T.Text or T.Sub) })
					tw(valueScale, 0.3, { Scale = s == 2 and 1.06 or 1 }, Back)
				end
				for _, g in ipairs({ hit, valueBox }) do
					g.MouseEnter:Connect(function() hovering = true state() end)
					g.MouseLeave:Connect(function() hovering = false state() end)
				end
				local function fromX(x)
					local w = math.max(1, track.AbsoluteSize.X - THUMB * (Window._scale or 1))
					local p = math.clamp((x - track.AbsolutePosition.X - HALF * (Window._scale or 1)) / w, 0, 1)
					el:SetValue(min + (max - min) * p)
				end
				hit.InputBegan:Connect(function(input)
					if isPress(input) and not el.Disabled then
						page.ScrollingEnabled = false
						fromX(input.Position.X)
						dragging = true
						state()
						beginDrag(function(i) fromX(i.Position.X) end, function()
							dragging = false
							page.ScrollingEnabled = true
							if el._dead then return end
							state()
							spawnSafe(o.OnInputComplete, el.Value)
						end)
					end
				end)
				el._cleanup = function() unShine() end
				valueBox.Focused:Connect(function() valueBox.Text = tostring(el.Value) end)
				valueBox.FocusLost:Connect(function()
					local n = tonumber((valueBox.Text:gsub("[^%d%.%-]", "")))
					if n then el:SetValue(n) end
					valueBox.Text = fmt(el.Value)
				end)

				local def = snap(tonumber(o.Default or o.Value) or min)
				el.Value = def
				valueBox.Text = fmt(def)
				local p0 = pct(def)
				fill.Size = UDim2.new(p0, at(p0), 1, 0)
				thumb.Position = UDim2.new(p0, at(p0), 0.5, 0)
				if o.Default ~= nil then spawnSafe(o.Callback, def) end
				return el
			end

			function S:CreateDropdown(a, b)
				local flag, o = norm(a, b)
				local multi = o.Multi == true
				local values = {}
				local wrap = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = nextOrder(), Parent = items }, { vlist(0) })
				local r = new("TextButton", { Text = "", Size = UDim2.new(1, 0, 0, ROW_H), BackgroundColor3 = WHITE, BackgroundTransparency = 1, Parent = wrap }, { corner(R.Control) })
