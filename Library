	local function height() return panel.AbsoluteSize.Y + SP.Card * 2 end
	content:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if not closed and entered then tw(slot, 0.15, { Size = UDim2.fromOffset(width, height()) }, Quint) end
	end)

	local elapsed, hovered = 0, false
	if not isTouch then
		card.MouseEnter:Connect(function() hovered = true end)
		card.MouseLeave:Connect(function() hovered = false end)
	end
	local stop
	local function close()
		if closed then return end
		closed = true
		if stop then stop() end
		tw(group, TOAST.Out, { GroupTransparency = 1, Position = UDim2.fromOffset(18, 0) }, Quad, Enum.EasingDirection.In)
		if shadow then tw(shadow, TOAST.Out, { ImageTransparency = 1 }) end
		task.delay(TOAST.Out, function()
			tw(slot, 0.22, { Size = UDim2.fromOffset(width, 0) }, Quint)
			task.delay(0.22, function()
				slot:Destroy()
				visibleToasts -= 1
				nextInQueue()
			end)
		end)
	end
	closeBtn.Activated:Connect(close)
	handle.Close = close

	task.spawn(function()
		RunService.Heartbeat:Wait()
		entered = true
		tw(slot, 0.22, { Size = UDim2.fromOffset(width, height()) }, Quint)
		tw(group, TOAST.In, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) }, Quint)
		if shadow then tw(shadow, TOAST.In, { ImageTransparency = 0.72 }) end
		stop = animate(function(_, dt)
			if not hovered then elapsed += dt end
			local left = math.clamp(1 - elapsed / duration, 0, 1)
			fill.Size = UDim2.fromScale(left, 1)
			fill.Visible = fill.AbsoluteSize.X >= fill.AbsoluteSize.Y
			if left <= 0 then close() end
		end)
	end)
end

function Library:Notify(o)
	o = type(o) == "table" and o or { Title = tostring(o) }
	-- the old library's keys
	o.Duration = o.Duration or o.Lifetime
	o.Type = o.Type or o.Style
	local handle = { Close = function() end }
	if visibleToasts >= TOAST.MaxVisible then
		local item = { o = o, handle = handle }
		table.insert(toastQueue, item)
		-- closing a queued toast just takes it out of the queue
		handle.Close = function() table.remove(toastQueue, table.find(toastQueue, item) or 0) end
	else
		showToast(o, handle)
	end
	return handle
end

-- Keybind engine
local binds = {}
local listening -- the bind currently waiting for a key

local function keyName(k)
	if k == nil then return "None" end
	if typeof(k) == "EnumItem" then
		if k.EnumType == Enum.UserInputType then
			return ({ MouseButton1 = "MB1", MouseButton2 = "MB2", MouseButton3 = "MB3" })[k.Name] or k.Name
		end
		local short = {
			LeftShift = "LShift", RightShift = "RShift", LeftControl = "LCtrl", RightControl = "RCtrl",
			LeftAlt = "LAlt", RightAlt = "RAlt", Return = "Enter", Backspace = "Back",
			One = "1", Two = "2", Three = "3", Four = "4", Five = "5", Six = "6", Seven = "7", Eight = "8", Nine = "9", Zero = "0",
		}
		return short[k.Name] or k.Name
	end
	return tostring(k)
end
local function parseKey(v)
	if typeof(v) == "EnumItem" then return v end
	if type(v) ~= "string" or v == "" or v == "None" then return nil end
	local mouse = ({ MB1 = "MouseButton1", MB2 = "MouseButton2", MB3 = "MouseButton3" })[v] or v
	if mouse:match("^MouseButton") then
		local ok, r = pcall(function() return Enum.UserInputType[mouse] end)
		if ok then return r end
	end
	local ok, r = pcall(function() return Enum.KeyCode[v] end)
	return ok and r or nil
end
local function matches(key, input)
	if key == nil then return false end
	if key.EnumType == Enum.KeyCode then return input.KeyCode == key end
	return input.UserInputType == key
end

on(UserInputService.InputBegan, function(input, processed)
	if listening then
		local b = listening
		if input.UserInputType == Enum.UserInputType.Keyboard then
			if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
				b:_set(nil)
			else
				b:_set(input.KeyCode)
			end
		elseif input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.MouseButton3 then
			b:_set(input.UserInputType)
		else
			return
		end
		return
	end
	if UserInputService:GetFocusedTextBox() then return end
	for _, b in ipairs(binds) do
		if not b.Disabled and matches(b.Key, input) then
			if b.Mode == "Hold" then
				b.State = true
				b:_trigger(true)
			elseif b.Mode == "Always" then
				b:_trigger(true)
			else
				b.State = not b.State
				b:_trigger(b.State)
			end
		end
	end
end)
on(UserInputService.InputEnded, function(input)
	for _, b in ipairs(binds) do
		if b.Mode == "Hold" and b.State and matches(b.Key, input) then
			b.State = false
			b:_trigger(false)
		end
	end
end)

local function keyChip(parent, opts, onTrigger, onChanged)
	local b = { Key = parseKey(opts.Default or opts.Value), Mode = opts.Mode or "Toggle", State = false, Disabled = false }
	local chip = new("TextButton", {
		Text = "", AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 22),
		Parent = parent,
	}, { pad(0, 8, 0, 8), new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center }) })
	local cs = controlGlass(chip, R.Small, false)
	chip.MouseEnter:Connect(function() if listening ~= b then glassHover(chip, cs, true) end end)
	chip.MouseLeave:Connect(function() if listening ~= b then glassHover(chip, cs, false) end end)
	local label = new("TextLabel", {
		Text = keyName(b.Key), FontFace = body(W_SEMI), TextSize = 12, TextColor3 = T.Sub,
		AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromScale(0, 1), Parent = chip,
	})
	new("UISizeConstraint", { MinSize = Vector2.new(28, 22), Parent = chip })
	b.Chip, b.Label = chip, label

	local stopPulse
	function b:_set(key)
		listening = nil
		if stopPulse then stopPulse() stopPulse = nil end
		self.Key = key
		self.State = false
		label.Text = keyName(key)
		tw(cs, 0.2, { Color = WHITE, Transparency = GL.Control[2] })
		glassHover(chip, nil, false)
		tw(label, 0.2, { TextColor3 = T.Sub })
		spawnSafe(onChanged, key)
	end
	function b:_trigger(state) spawnSafe(onTrigger, state) end
	function b:Listen()
		if listening and listening ~= self then listening:_set(listening.Key) end
		listening = self
		label.Text = "..."
		tw(label, 0.2, { TextColor3 = T.Text })
		cs.Color = T.Accent2
		stopPulse = animate(function(t) cs.Transparency = 0.35 + math.sin(t * 7) * 0.3 end)
	end
	chip.Activated:Connect(function()
		if b.Disabled then return end
		task.defer(function() b:Listen() end) -- defer so the click itself is not captured
	end)
	table.insert(binds, b)
	return b
end

