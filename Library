			function S:CreateToggle(a, b)
				local flag, o = norm(a, b)
				local r = row(ROW_H, true)
				local t1, t2 = titled(r, o, 60)
				local TW, TH, K = 34, 20, 14
				local track = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -SP.Text, 0.5, 0), Size = UDim2.fromOffset(TW, TH), Parent = r })
				local tstroke = glass(track, TH / 2, 0.08, 0.84)
				local fill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BackgroundTransparency = 1, Parent = track }, { round() })
				paint(gradient({ Rotation = 0, Parent = fill }), "Color", "seq")
				local gloss = new("Frame", { Size = UDim2.new(1, -4, 0.5, -1), Position = UDim2.fromOffset(2, 2), BackgroundColor3 = WHITE, BackgroundTransparency = 1, Parent = fill }, { round(), gradient({ Rotation = 90, Transparency = seq(0.55, 1) }) })
				local knob = new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0), Size = UDim2.fromOffset(K, K), BackgroundColor3 = T.Sub, ZIndex = 2, Parent = track }, { round() })
				local chipHolder = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -(SP.Text + TW + SP.Group), 0.5, 0), Size = UDim2.fromOffset(0, 22), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, Parent = r })
				r.MouseEnter:Connect(function() tw(tstroke, 0.2, { Transparency = 0.74 }) end)
				r.MouseLeave:Connect(function() tw(tstroke, 0.2, { Transparency = 0.84 }) end)
				local el = element("Toggle", flag, r, o, t1, t2)
				el.Value = false
				el._callback = o.Callback
				local function render(v, instant)
					local t = instant and 0 or 0.32
					tw(fill, t, { BackgroundTransparency = v and 0 or 1 })
					tw(gloss, t, { BackgroundTransparency = v and 0 or 1 })
					tw(knob, t, { Position = UDim2.new(0, v and (TW - K - 3) or 3, 0.5, 0), BackgroundColor3 = v and WHITE or T.Sub }, Back)
					if not instant then
						knob.Size = UDim2.fromOffset(K + 5, K)
						tw(knob, 0.3, { Size = UDim2.fromOffset(K, K) }, Back)
					end
				end
				function el:SetValue(v, silent)
					v = v and true or false
					local changed = v ~= self.Value
					self.Value = v
					render(v)
					if changed or silent == false then
						if not silent then spawnSafe(o.Callback, v) end
						self:_fire(v)
					end
					return self
				end
				function el:GetState() return self.Value end
				el.Set = el.SetValue
				el._serialize = function(self) return self.Value end
				el._deserialize = function(self, v) self:SetValue(v == true) end
				r.Activated:Connect(function() if not el.Disabled then el:SetValue(not el.Value) end end)
				function el:Keybind(ka, kb)
					local kopts = (type(ka) == "table" and ka) or kb or {}
					local kflag = type(ka) == "string" and ka or kopts.Flag
					local kb2 = keyChip(chipHolder, kopts, function(state)
						if kopts.Mode == "Hold" then el:SetValue(state) else el:SetValue(not el.Value) end
					end, kopts.ChangedCallback)
					task.defer(function()
						local w = (chipHolder.AbsoluteSize.X / (Window._scale or 1)) + SP.Text * 2 + TW + SP.Group * 2
						t1.Size = UDim2.new(1, -w, t1.Size.Y.Scale, t1.Size.Y.Offset)
						if t2 then t2.Size = UDim2.new(1, -w, 0, 16) end
					end)
					local kel = { Type = "Keybind", Value = kb2.Key, Mode = kb2.Mode }
					function kel:SetValue(k, mode) kb2:_set(parseKey(k)) if mode then kb2.Mode = mode end kel.Value = kb2.Key end
					function kel:GetState() return kb2.State end
					kel._serialize = function() return keyName(kb2.Key) ~= "None" and (kb2.Key and kb2.Key.Name) or "None" end
					kel._deserialize = function(_, v) kb2:_set(parseKey(v)) end
					local prev = kb2._set
					kb2._set = function(self, k) prev(self, k) kel.Value = k end
					if kflag then Library.Options[kflag] = kel end
					return kel
				end
				if o.Default or o.Value then
					el.Value = true
					render(true, true)
					spawnSafe(o.Callback, true)
				end
				return el
			end

