				if v then
					SB._spin = animate(function(_, dt) refreshIc.Rotation = (refreshIc.Rotation + dt * 360) % 360 end)
				else
					if SB._spin then SB._spin() SB._spin = nil end
					tw(refreshIc, 0.3, { Rotation = 0 })
				end
			end
			if v then setSub("Looking for servers...") else summary() end
			showEmpty()
		end

