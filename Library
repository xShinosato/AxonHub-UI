local function setIcon(img, icon)
	if icon == nil or icon == "" then img.Image = "" return false end
	local src, tint = resolveImage(icon)
	if src then
		img.ImageRectSize, img.ImageRectOffset = Vector2.zero, Vector2.zero
		img:SetAttribute("AxonKeepColor", not tint or nil)
		if not tint then img.ImageColor3 = Color3.new(1, 1, 1) end
		if src:match("^https?://") then
			img.Image = ""
			urlAsset(src, function(a) if a and img.Parent then img.Image = a end end)
		else
			img.Image = src
		end
		return true
	end
	img:SetAttribute("AxonKeepColor", nil)
	if type(icon) ~= "string" then img.Image = "" return false end
	local key = icon:gsub("^molto:", ""):gsub("^lucide/", ""):gsub("^lucide%-", ""):lower()
	local d = ICONS[key]
	if d then
		img.Image, img.ImageRectOffset, img.ImageRectSize = d[1], d[2], ICON_RECT
		return true
	end
	img.Image = ""
	return false
end
Library.Icons = ICONS

