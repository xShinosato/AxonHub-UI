				r:GetPropertyChangedSignal("AbsoluteSize"):Connect(capPill)
				task.defer(capPill)
				local chev = icon(valuePill, "chevron-down", 14, T.Muted, { LayoutOrder = 2 })

				-- the list opens in a recessed well, flush with the row edges
				local OPT, OGAP, WPAD = 28, 2, 4
				local body_ = new("Frame", { Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1, ClipsDescendants = true, Parent = wrap })
				local panel = new("Frame", { Position = UDim2.fromOffset(0, SP.Item), Size = UDim2.new(1, 0, 1, -SP.Item * 2), Parent = body_ })
				recess(panel, R.Control)
				local useSearch = o.Search == true
				local search
				if useSearch then
					search = new("TextBox", {
						Text = "", PlaceholderText = "Search", PlaceholderColor3 = T.Muted, TextSize = 13, ClearTextOnFocus = false,
						Position = UDim2.fromOffset(WPAD, WPAD), Size = UDim2.new(1, -WPAD * 2, 0, OPT),
						TextXAlignment = Enum.TextXAlignment.Left, Parent = panel,
					}, { pad(0, 8, 0, 28) })
					controlGlass(search, R.Small, false)
					icon(search, "search", 14, T.Muted, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, -14, 0.5, 0) })
				end
				local listTop = useSearch and (WPAD + OPT + OGAP * 2) or WPAD
				local list = new("ScrollingFrame", {
					Position = UDim2.fromOffset(WPAD, listTop), Size = UDim2.new(1, -WPAD * 2, 1, -listTop - WPAD), BackgroundTransparency = 1,
					CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 2, ScrollingDirection = Enum.ScrollingDirection.Y, Parent = panel,
				}, { vlist(OGAP) })
				paint(list, "ScrollBarImageColor3")

				local el = element("Dropdown", flag, wrap, o, t1, t2)
				el._cleanup = function() if valueText._unregister then valueText._unregister() end end
				el.Values = values
				el.Multi = multi
				el.Value = multi and {} or nil
				local open = false
				local optionRows = {}

				local function display()
					local text
					if multi then
						local picked = {}
						for _, v in ipairs(values) do if el.Value[v] then table.insert(picked, v) end end
						text = #picked == 0 and "None" or table.concat(picked, ", ")
					else
						text = el.Value ~= nil and tostring(el.Value) or "None"
					end
					valueText:SetText(text, multi and ", " or "  ·  ")
					valueText:TweenColor(text == "None" and T.Muted or T.Text)
				end
				local function visibleCount()
					local n = 0
					for _, ro in pairs(optionRows) do if ro.btn.Visible then n += 1 end end
					return n
				end
				local function height()
					local n = math.min(math.max(visibleCount(), 1), 6)
					return SP.Item * 2 + listTop + n * (OPT + OGAP) - OGAP + WPAD
				end
				local function setOpen(v)
					open = v
					tw(body_, 0.38, { Size = UDim2.new(1, 0, 0, v and height() or 0) }, Quint)
					tw(chev, 0.35, { Rotation = v and 180 or 0, ImageColor3 = v and T.Accent2 or T.Muted }, Back)
				end
				local function refreshRows()
					for v, ro in pairs(optionRows) do
						local sel = multi and el.Value[v] or (not multi and el.Value == v)
						tw(ro.btn, 0.2, { BackgroundTransparency = sel and 0.88 or 1 })
						tw(ro.label, 0.2, { TextColor3 = sel and T.Text or T.Sub })
						tw(ro.check, 0.25, { ImageTransparency = sel and 0 or 1, Size = UDim2.fromOffset(sel and 14 or 6, sel and 14 or 6) }, Back)
					end
				end
				local function commit(silent)
					display()
					refreshRows()
					if not silent then spawnSafe(o.Callback, el.Value) end
					el:_fire(el.Value)
				end
				local function build()
					for _, ro in pairs(optionRows) do ro.btn:Destroy() end
					table.clear(optionRows)
					for i, v in ipairs(values) do
						local ob = new("TextButton", { Text = "", Size = UDim2.new(1, 0, 0, OPT), BackgroundColor3 = T.Accent, BackgroundTransparency = 1, LayoutOrder = i, Parent = list }, { corner(R.Small) })
						paint(ob, "BackgroundColor3")
						local ol = new("TextLabel", { Text = v, TextSize = 13, TextColor3 = T.Sub, Position = UDim2.fromOffset(SP.Text - WPAD, 0), Size = UDim2.new(1, -40, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = ob })
						local ck = icon(ob, "check", 14, T.Accent2, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -(SP.Text - WPAD + 7), 0.5, 0), ImageTransparency = 1 })
						paint(ck, "ImageColor3", "light")
						ob.MouseEnter:Connect(function() tw(ol, 0.15, { TextColor3 = T.Text }) end)
						ob.MouseLeave:Connect(function()
							local sel = multi and el.Value[v] or (not multi and el.Value == v)
							tw(ol, 0.15, { TextColor3 = sel and T.Text or T.Sub })
						end)
						ob.Activated:Connect(function()
							if el.Disabled then return end
							if multi then
								if el.Value[v] then
									local count = 0
									for _ in pairs(el.Value) do count += 1 end
									if o.AllowNull == false and count <= 1 then return end
									el.Value[v] = nil
								else
									el.Value[v] = true
								end
								commit()
							else
								if el.Value == v and o.AllowNull then el.Value = nil else el.Value = v end
								commit()
								task.delay(0.12, function() setOpen(false) end)
							end
						end)
						optionRows[v] = { btn = ob, label = ol, check = ck }
					end
					refreshRows()
				end
				function el:SetValues(list_)
					table.clear(values)
					for _, v in ipairs(list_ or {}) do table.insert(values, tostring(v)) end
					local lost = false
					if multi then
						for k in pairs(el.Value) do if not table.find(values, k) then el.Value[k] = nil lost = true end end
					elseif el.Value ~= nil and not table.find(values, el.Value) then
						el.Value = nil
						lost = true
					end
					build()
					display()
					if open then setOpen(true) end
					if lost then commit() end
					return self
				end
				el.Refresh = el.SetValues
				function el:SetValue(v, silent)
					if multi then
						local nv = {}
						if type(v) == "table" then
							for k, x in pairs(v) do
								if type(k) == "number" then nv[tostring(x)] = true elseif x then nv[tostring(k)] = true end
							end
						elseif v ~= nil then
							nv[tostring(v)] = true
						end
						el.Value = nv
					else
						el.Value = v ~= nil and tostring(v) or nil
					end
					commit(silent)
					return self
				end
				function el:GetActiveValues()
					if multi then
						local out = {}
						for _, v in ipairs(values) do if el.Value[v] then table.insert(out, v) end end
						return out
					end
					return el.Value ~= nil and 1 or 0
				end
				function el:Open() setOpen(true) end
				function el:Close() setOpen(false) end
				el._serialize = function(self) return multi and self:GetActiveValues() or self.Value end
				el._deserialize = function(self, v) self:SetValue(v) end
				r.Activated:Connect(function() if not el.Disabled then setOpen(not open) end end)
				if search then
					search:GetPropertyChangedSignal("Text"):Connect(function()
						local q = search.Text:lower()
						for v, ro in pairs(optionRows) do ro.btn.Visible = q == "" or v:lower():find(q, 1, true) ~= nil end
						if open then setOpen(true) end
					end)
				end

				for _, v in ipairs(o.Values or o.Options or {}) do table.insert(values, tostring(v)) end
				build()
				local def = o.Default
				if def == nil and o.Value ~= nil then def = o.Value end
				if type(def) == "number" and not multi and values[def] then def = values[def] end
				if def ~= nil then
					el:SetValue(def, true)
					spawnSafe(o.Callback, el.Value)
				else
					display()
				end
				return el
			end

			function S:CreateInput(a, b)
				local flag, o = norm(a, b)
				local r = row(ROW_H, false)
				local t1, t2 = titled(r, o, 170)
				local box = new("TextBox", {
					Text = tostring(o.Default or o.Value or ""), PlaceholderText = tostring(o.Placeholder or o.PlaceholderText or "Type here"),
					PlaceholderColor3 = T.Muted, TextSize = 13, ClearTextOnFocus = o.ClearTextOnFocus == true,
					AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -SP.Text, 0.5, 0), Size = UDim2.new(0.48, 0, 0, 26),
					TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = r,
				}, { pad(0, 8, 0, 8) })
				local bs = controlGlass(box, R.Small, false)
				t1.Size = UDim2.new(0.52, -(SP.Text + SP.Group), t1.Size.Y.Scale, t1.Size.Y.Offset)
				if t2 then t2.Size = UDim2.new(0.52, -(SP.Text + SP.Group), 0, 16) end
				local el = element("Input", flag, r, o, t1, t2)
				el.Value = box.Text
				box.MouseEnter:Connect(function() if not box:IsFocused() then glassHover(box, bs, true) end end)
				box.MouseLeave:Connect(function() if not box:IsFocused() then glassHover(box, bs, false) end end)
				box.Focused:Connect(function() tw(bs, 0.2, { Color = T.Accent2, Transparency = 0.35 }) tw(box, 0.2, { BackgroundTransparency = 1 - GL.ControlHover }) end)
				local function apply(text, silent)
					if o.Numeric then text = text:gsub("[^%d%.%-]", "") end
					if o.MaxLength then text = text:sub(1, o.MaxLength) end
					box.Text = text
					local changed = text ~= el.Value
					el.Value = text
					if changed then
						if not silent then spawnSafe(o.Callback, text) end
						el:_fire(text)
					end
				end
				box.FocusLost:Connect(function(enter)
					tw(bs, 0.25, { Color = WHITE, Transparency = GL.Control[2] })
					glassHover(box, nil, false)
					if o.Finished == false then return end
					apply(box.Text)
				end)
				if o.Finished == false then
					box:GetPropertyChangedSignal("Text"):Connect(function() if box:IsFocused() then apply(box.Text) end end)
				end
				function el:SetValue(v, silent) apply(tostring(v or ""), silent) return self end
				el._serialize = function(self) return self.Value end
				el._deserialize = function(self, v) self:SetValue(v) end
				return el
			end

			function S:CreateKeybind(a, b)
				local flag, o = norm(a, b)
				local r = row(ROW_H, false)
				local t1, t2 = titled(r, o, 110)
				local holder = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -SP.Text, 0.5, 0), Size = UDim2.fromOffset(0, 22), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, Parent = r })
				fitTitle(t1, t2, holder)
				local el = element("Keybind", flag, r, o, t1, t2)
				local clickFns = {}
				local kb = keyChip(holder, o, function(state)
					spawnSafe(o.Callback, state)
					for _, fn in ipairs(clickFns) do spawnSafe(fn, state) end
				end, function(key)
					el.Value = key
					spawnSafe(o.ChangedCallback, key)
					el:_fire(key)
				end)
				el.Value = kb.Key
				el.Mode = kb.Mode
				el._onDisabled = function(d) kb.Disabled = d end
				function el:GetState() return kb.State end
				function el:SetValue(k, mode)
					if mode then kb.Mode = mode el.Mode = mode end
					kb:_set(parseKey(k))
					return self
				end
				function el:OnClick(fn) table.insert(clickFns, fn) return self end
				el._serialize = function() return kb.Key and kb.Key.Name or "None" end
				el._deserialize = function(self, v) self:SetValue(v) end
				return el
			end

			function S:CreateColorpicker(a, b)
				local flag, o = norm(a, b)
				local wrap = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = nextOrder(), Parent = items }, { vlist(0) })
				local r = new("TextButton", { Text = "", Size = UDim2.new(1, 0, 0, ROW_H), BackgroundColor3 = WHITE, BackgroundTransparency = 1, Parent = wrap }, { corner(R.Control) })
				r.MouseEnter:Connect(function() tw(r, 0.2, { BackgroundTransparency = 0.965 }) end)
				r.MouseLeave:Connect(function() tw(r, 0.25, { BackgroundTransparency = 1 }) end)
				local t1, t2 = titled(r, o, 70)
				local swatch = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -SP.Text, 0.5, 0), Size = UDim2.fromOffset(34, 20), Parent = r }, { corner(R.Small), stroke(0.75) })
				new("Frame", { Size = UDim2.new(1, -4, 0.5, -2), Position = UDim2.fromOffset(2, 2), BackgroundColor3 = WHITE, BackgroundTransparency = 0, Parent = swatch }, { corner(R.Tiny - 1), gradient({ Rotation = 90, Transparency = seq(0.7, 1) }) })

				-- picker well: 8px inset, the same gap between its parts
				local PK = 8
				local body_ = new("Frame", { Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1, ClipsDescendants = true, Parent = wrap })
				local panel = new("Frame", { Position = UDim2.fromOffset(0, SP.Item), Size = UDim2.new(1, 0, 0, 116 + 26 + PK * 3), Parent = body_ }, { pad(PK) })
				recess(panel, R.Control)
				local sv = new("Frame", { Size = UDim2.new(1, -(18 + PK), 0, 116), BackgroundTransparency = 1, Parent = panel })
				local svMask = new("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 0, 0), BackgroundTransparency = 0, Parent = sv }, { corner(R.Small) })
				local white = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, Parent = svMask })
				gradient({ Transparency = NumberSequence.new(0, 1), Parent = white })
				local black = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), Parent = svMask })
				gradient({ Rotation = 90, Transparency = NumberSequence.new(1, 0), Parent = black })
				local svCursor = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(14, 14), BackgroundTransparency = 1, ZIndex = 4, Parent = sv }, { round(), stroke(0, Color3.new(1, 1, 1), 2) })
				local hue = new("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(18, 116), BackgroundColor3 = WHITE, Parent = panel }, { corner(R.Small) })
				local hk = {}
				for i = 0, 6 do table.insert(hk, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV((i / 6) % 1, 1, 1))) end
				gradient({ Rotation = 90, Color = ColorSequence.new(hk), Parent = hue })
				local hueCursor = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0), Size = UDim2.new(1, 4, 0, 6), BackgroundColor3 = WHITE, ZIndex = 3, Parent = hue }, { corner(R.Tiny), stroke(0.5, Color3.new(0, 0, 0)) })
				local hexBox = new("TextBox", {
					Text = "", FontFace = body(W_SEMI), TextSize = 13, ClearTextOnFocus = false, Position = UDim2.fromOffset(0, 116 + PK), Size = UDim2.new(1, -(80 + PK), 0, 26), Parent = panel,
				})
				controlGlass(hexBox, R.Small, false)
				local rainbowBtn = new("TextButton", { Text = "Rainbow", FontFace = body(W_SEMI), TextSize = 12, TextColor3 = T.Sub, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 116 + PK), Size = UDim2.fromOffset(80, 26), Parent = panel })
				local rbStroke = controlGlass(rainbowBtn, R.Small, false)

				local el = element("Colorpicker", flag, wrap, o, t1, t2)
				el.Transparency = tonumber(o.Transparency) or 0
				local h, s, v = 0, 0, 1
				local open, rainbow, stopRainbow = false, false, nil
				local function render()
					local c = Color3.fromHSV(h, s, v)
					svMask.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
					svCursor.Position = UDim2.fromScale(s, 1 - v)
					hueCursor.Position = UDim2.fromScale(0.5, h)
					swatch.BackgroundColor3 = c
					if not hexBox:IsFocused() then hexBox.Text = hex(c) end
				end
				local function push(silent)
					el.Value = Color3.fromHSV(h, s, v)
					render()
					if not silent then spawnSafe(o.Callback, el.Value, el.Transparency) end
					el:_fire(el.Value)
				end
				function el:SetValueRGB(c, transparency, silent)
					h, s, v = c:ToHSV()
					if transparency then el.Transparency = transparency end
					push(silent)
					return self
				end
				function el:SetValue(c, transparency, silent)
					if typeof(c) == "Color3" then return el:SetValueRGB(c, transparency, silent) end
					if type(c) == "table" then h, s, v = c[1] or h, c[2] or s, c[3] or v push(silent) end
					return self
				end
				el._serialize = function(self) return { hex(self.Value), self.Transparency } end
				el._deserialize = function(self, d)
					local hx = type(d) == "table" and d[1] or d
					if type(hx) == "string" then
						local ok, c = pcall(Color3.fromHex, hx)
						if ok then self:SetValueRGB(c, type(d) == "table" and d[2] or nil) end
					end
				end
				local function setOpen(x)
					open = x
					tw(body_, 0.4, { Size = UDim2.new(1, 0, 0, x and (116 + 26 + PK * 3 + SP.Item * 2) or 0) }, Quint)
					tw(swatch, 0.35, { Size = UDim2.fromOffset(x and 42 or 34, 20) }, Back)
				end
				r.Activated:Connect(function() if not el.Disabled then setOpen(not open) end end)

				local dragTarget
				local function dragAt(pos)
					if dragTarget == "sv" then
						s = math.clamp((pos.X - sv.AbsolutePosition.X) / sv.AbsoluteSize.X, 0, 1)
						v = 1 - math.clamp((pos.Y - sv.AbsolutePosition.Y) / sv.AbsoluteSize.Y, 0, 1)
					elseif dragTarget == "hue" then
						h = math.clamp((pos.Y - hue.AbsolutePosition.Y) / hue.AbsoluteSize.Y, 0, 0.999)
					end
					push()
				end
				for name, target in pairs({ sv = sv, hue = hue }) do
					target.InputBegan:Connect(function(input)
						if isPress(input) and not el.Disabled then
							dragTarget = name
							page.ScrollingEnabled = false
							dragAt(input.Position)
							beginDrag(function(i) if not el._dead then dragAt(i.Position) end end, function()
								dragTarget = nil
								page.ScrollingEnabled = true
							end)
						end
					end)
				end
				hexBox.FocusLost:Connect(function()
					local ok, c = pcall(Color3.fromHex, (hexBox.Text:gsub("#", "")))
					if ok and c then el:SetValueRGB(c) else render() end
				end)
				rainbowBtn.Activated:Connect(function()
					rainbow = not rainbow
					tw(rainbowBtn, 0.2, { TextColor3 = rainbow and T.Text or T.Sub })
					tw(rbStroke, 0.2, { Color = rainbow and T.Accent2 or WHITE, Transparency = rainbow and 0.35 or GL.Control[2] })
					if rainbow then
						stopRainbow = animate(function(_, dt) h = (h + dt * 0.12) % 1 push() end)
					elseif stopRainbow then
						stopRainbow()
						stopRainbow = nil
					end
				end)
				el.SetRainbow = function(self, x)
					if (x and true or false) == rainbow then return end
					rainbow = not rainbow
					if rainbow then stopRainbow = animate(function(_, dt) h = (h + dt * 0.12) % 1 push() end)
					elseif stopRainbow then stopRainbow() stopRainbow = nil end
					rainbowBtn.TextColor3 = rainbow and T.Text or T.Sub
				end

				local def = o.Default or o.Value or T.Accent
				h, s, v = def:ToHSV()
				el.Value = def
				render()
				if o.Default then spawnSafe(o.Callback, def, el.Transparency) end
				return el
			end

			function S:CreateParagraph(a, b)
				local flag, o = norm(a, b)
				if type(a) == "string" and b == nil then o = { Title = a } flag = nil end
				local holder = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = nextOrder(), Parent = items }, { pad(2, 0, 2, 0) })
				local r = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = holder }, { pad(SP.Group, SP.Text, SP.Group + 1, SP.Text), vlist(SP.Item + 1) })
				controlGlass(r, R.Control, false)
				local t1 = new("TextLabel", { Text = tostring(o.Title or ""), FontFace = body(W_SEMI), TextSize = 14, Size = UDim2.new(1, 0, 0, 18), TextXAlignment = Enum.TextXAlignment.Left, Parent = r })
				local t2 = new("TextLabel", { Text = tostring(o.Content or o.Description or ""), TextSize = 13, TextColor3 = T.Sub, TextWrapped = true, RichText = true, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 2, Parent = r })
				t1.Visible = t1.Text ~= ""
				local el = element("Paragraph", flag, holder, o, t1, t2)
				local function addThumb(src)
					local size = tonumber(o.ImageSize) or 40
					el._thumb = thumb(holder, src, size, SP.Text)
					el._thumb.Position = UDim2.new(0, SP.Text, 0.5, 0)
					r:FindFirstChildOfClass("UIPadding").PaddingLeft = UDim.new(0, SP.Text + size + SP.Text)
					r.Size = UDim2.new(1, 0, 0, size + SP.Group * 2)
				end
				if o.Image then addThumb(o.Image) end
				function el:SetImage(v)
					if not self._thumb then if v then addThumb(v) end return self end
					setThumb(self._thumb, v)
					return self
				end
				function el:SetContent(s) t2.Text = tostring(s) return self end
				el.SetDesc, el.Set, el.SetText = el.SetContent, el.SetContent, el.SetContent
				return el
			end
			function S:CreateImage(a, b)
				local flag, o
				if type(a) == "table" then flag, o = a.Flag, a
				elseif b == nil and resolveImage(a) then flag, o = nil, { Image = a }
				else flag, o = a, (type(b) == "table" and b) or {} end
				local H = tonumber(o.Height) or 140
				local holder = new("Frame", { Size = UDim2.new(1, 0, 0, H + 4), BackgroundTransparency = 1, LayoutOrder = nextOrder(), Parent = items }, { pad(2, 0, 2, 0) })
				local img = new(o.Callback and "ImageButton" or "ImageLabel", {
					Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BackgroundTransparency = 0.955, AutoButtonColor = o.Callback and false or nil,
					ScaleType = o.ScaleType or Enum.ScaleType.Crop, ImageTransparency = tonumber(o.Transparency) or 0, Parent = holder,
				}, { corner(R.Control), stroke(0.9) })
				local imgScale = new("UIScale", { Parent = img })
				setIcon(img, o.Image or o.Url)
				local shade, tTitle, tCap
				local function caption()
					if shade or not (o.Title or o.Caption) then return end
					shade = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0, ZIndex = 2, Parent = img }, {
						corner(R.Control), gradient({ Rotation = 90, Transparency = NumberSequence.new({ kp(0, 1), kp(0.45, 1), kp(1, 0.25) }) }),
					})
					local col = new("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, SP.Text, 1, -SP.Group), Size = UDim2.new(1, -SP.Text * 2, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, ZIndex = 3, Parent = img }, { vlist(1) })
					tTitle = new("TextLabel", { Text = tostring(o.Title or ""), FontFace = body(W_SEMI), TextSize = 15, TextColor3 = WHITE, Size = UDim2.new(1, 0, 0, 18), TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 3, Parent = col })
					tCap = new("TextLabel", { Text = tostring(o.Caption or ""), TextSize = 12, TextColor3 = Color3.fromRGB(215, 210, 228), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 2, ZIndex = 3, Parent = col })
					tTitle.Visible, tCap.Visible = tTitle.Text ~= "", tCap.Text ~= ""
				end
				caption()
				-- AspectRatio keeps the picture's shape at every width
				if tonumber(o.AspectRatio) then
					local function fit()
						local s = Window._scale or 1
						local w = holder.AbsoluteSize.X / s
						if w > 0 then holder.Size = UDim2.new(1, 0, 0, math.floor(w / tonumber(o.AspectRatio) + 0.5) + 4) end
					end
					holder:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
					task.defer(fit)
				end
				local el = element("Image", flag, holder, o, tTitle, tCap)
				if o.Callback then
					img.MouseEnter:Connect(function() tw(imgScale, 0.3, { Scale = 1.012 }) tw(img, 0.2, { BackgroundTransparency = 0.93 }) end)
					img.MouseLeave:Connect(function() tw(imgScale, 0.3, { Scale = 1 }) tw(img, 0.2, { BackgroundTransparency = 0.955 }) end)
					img.InputBegan:Connect(function(i) if isPress(i) then tw(imgScale, 0.1, { Scale = 0.985 }) end end)
					img.InputEnded:Connect(function(i) if isPress(i) then tw(imgScale, 0.35, { Scale = 1 }, Back) end end)
					img.Activated:Connect(function() if not el.Disabled then spawnSafe(o.Callback) end end)
				end
				el.Value = o.Image
				function el:SetImage(v) self.Value = v setIcon(img, v) return self end
				el.SetValue = el.SetImage
				function el:SetTitle(t) o.Title = t caption() if tTitle then tTitle.Text = tostring(t or "") tTitle.Visible = tTitle.Text ~= "" end return self end
				function el:SetCaption(t) o.Caption = t caption() if tCap then tCap.Text = tostring(t or "") tCap.Visible = tCap.Text ~= "" end return self end
				el.SetDesc = el.SetCaption
				function el:SetHeight(h) o.AspectRatio = nil holder.Size = UDim2.new(1, 0, 0, (tonumber(h) or H) + 4) return self end
				return el
			end

			function S:CreateItem(a, b)
				local flag, o = norm(a, b)
				local TILE = tonumber(o.ImageSize) or 36
				local holder = new("Frame", { Size = UDim2.new(1, 0, 0, 56), BackgroundTransparency = 1, LayoutOrder = nextOrder(), Parent = items }, { pad(2, 0, 2, 0) })
				local card = new("Frame", { Size = UDim2.fromScale(1, 1), Parent = holder })
				local cs = controlGlass(card, R.Control)
				local tile = new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 8, 0.5, 0), Size = UDim2.fromOffset(TILE, TILE), BackgroundColor3 = WHITE, BackgroundTransparency = 0.94, Parent = card }, { corner(R.Control) })
				local tileStroke = new("UIStroke", { Color = WHITE, Transparency = 1, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = tile })
				local pic = new("ImageLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1, Parent = tile }, { corner(R.Control) })
				local function paintPic(v)
					setIcon(pic, v or "")
					local isPic = pic:GetAttribute("AxonKeepColor") == true
					pic.Size = isPic and UDim2.new(1, -4, 1, -4) or UDim2.fromScale(0.55, 0.55)
					pic.ScaleType = Enum.ScaleType.Fit
					if not isPic then pic.ImageColor3 = T.Sub end
				end
				local function paintColor(c)
					if typeof(c) == "Color3" then
						tile.BackgroundColor3, tile.BackgroundTransparency = c, 0.8
						tileStroke.Color, tileStroke.Transparency = c, 0.35
					else
						tile.BackgroundColor3, tile.BackgroundTransparency = WHITE, 0.94
						tileStroke.Transparency = 1
					end
				end
				paintPic(o.Image)
				paintColor(o.Color)
				local textX = 8 + TILE + 10
				local col = new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, textX, 0.5, 0), Size = UDim2.new(1, -(textX + 10), 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = card }, { vlist(2) })
				local t1 = new("TextLabel", { Text = tostring(o.Title or ""), FontFace = body(W_SEMI), TextSize = 14, RichText = true, Size = UDim2.new(1, 0, 0, 17), TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = col })
				local t2 = new("TextLabel", { Text = tostring(o.Description or ""), TextSize = 12, TextColor3 = T.Sub, RichText = true, TextWrapped = true, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 2, Parent = col })
				t2.Visible = t2.Text ~= ""
				-- right side
				local right = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -9, 0.5, 0), Size = UDim2.fromOffset(0, 0), AutomaticSize = Enum.AutomaticSize.XY, BackgroundTransparency = 1, Parent = card }, {
					new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Right, Padding = UDim.new(0, 2) }),
				})
				local v1 = new("TextLabel", { Text = "", FontFace = body(W_SEMI), TextSize = 12, RichText = true, TextColor3 = o.ValueColor or T.Text, Size = UDim2.fromOffset(0, 15), AutomaticSize = Enum.AutomaticSize.X, TextXAlignment = Enum.TextXAlignment.Right, Visible = false, Parent = right })
				local v2 = new("TextLabel", { Text = "", TextSize = 11, RichText = true, TextColor3 = T.Muted, Size = UDim2.fromOffset(0, 14), AutomaticSize = Enum.AutomaticSize.X, TextXAlignment = Enum.TextXAlignment.Right, LayoutOrder = 2, Visible = false, Parent = right })
				local act = new("TextButton", { Text = "", Size = UDim2.fromOffset(tonumber(o.ActionWidth) or 70, 30), BackgroundTransparency = 1, LayoutOrder = 3, Visible = false, Parent = right })
				local actFill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, Parent = act }, { corner(R.Control) })
				local actGrad = gradient({ Rotation = 0, Parent = actFill })
				paint(actGrad, "Color", "seq")
				local actStroke = new("UIStroke", { Color = WHITE, Transparency = 0.7, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = actFill })
				local actGloss = new("Frame", { Size = UDim2.new(1, -4, 0.5, -2), Position = UDim2.fromOffset(2, 2), BackgroundColor3 = WHITE, BackgroundTransparency = 0, Parent = actFill }, { corner(R.Control - 2), gradient({ Rotation = 90, Transparency = seq(0.8, 1) }) })
				local actLabel = new("TextLabel", { Text = "", FontFace = body(W_SEMI), TextSize = 13, TextColor3 = WHITE, Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = act })
				local actScale = new("UIScale", { Parent = act })
				local STYLES = {
					Primary = function() actGrad.Enabled = true actFill.BackgroundColor3, actFill.BackgroundTransparency = WHITE, 0 actGloss.Visible = true actStroke.Transparency = 0.7 actLabel.TextColor3 = WHITE end,
					Muted = function() actGrad.Enabled = false actFill.BackgroundColor3, actFill.BackgroundTransparency = WHITE, 0.92 actGloss.Visible = false actStroke.Transparency = 0.88 actLabel.TextColor3 = T.Sub end,
					Good = function() actGrad.Enabled = false actFill.BackgroundColor3, actFill.BackgroundTransparency = T.Good, 0.2 actGloss.Visible = true actStroke.Transparency = 0.75 actLabel.TextColor3 = WHITE end,
					Bad = function() actGrad.Enabled = false actFill.BackgroundColor3, actFill.BackgroundTransparency = T.Bad, 0.2 actGloss.Visible = true actStroke.Transparency = 0.75 actLabel.TextColor3 = WHITE end,
				}
				local function fitText()
					local s_ = Window._scale or 1
					local rw = right.AbsoluteSize.X / s_
					col.Size = UDim2.new(1, -(textX + 10 + (rw > 0 and rw + 10 or 0)), 0, 0)
					local h = math.max(TILE + 16, math.ceil(col.AbsoluteSize.Y / s_) + 18)
					holder.Size = UDim2.new(1, 0, 0, h + 4)
				end
				right:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitText)
				col:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitText)
				task.defer(fitText)

				local el = element("Item", flag, holder, o, t1, t2)
				el._thumb = nil
				function el:SetImage(v) o.Image = v paintPic(v) return self end
				function el:SetColor(c) o.Color = c paintColor(c) return self end
				function el:SetTitle(v) self.Title = v t1.Text = tostring(v or "") return self end
				function el:SetDescription(v) t2.Text = tostring(v or "") t2.Visible = t2.Text ~= "" return self end
				el.SetDesc = el.SetDescription
				function el:SetValue(v, color)
					v1.Text = tostring(v or "") v1.Visible = v1.Text ~= ""
					if color then v1.TextColor3 = color end
					return self
				end
				function el:SetSubValue(v) v2.Text = tostring(v or "") v2.Visible = v2.Text ~= "" return self end
				function el:SetAction(text_, style)
					act.Visible = text_ ~= nil and text_ ~= ""
					actLabel.Text = tostring(text_ or "")
					;(STYLES[style or "Primary"] or STYLES.Primary)()
					return self
				end
				el:SetValue(o.Value) el:SetSubValue(o.SubValue)
				if o.Action then el:SetAction(o.Action, o.ActionStyle) end
				card.MouseEnter:Connect(function() glassHover(card, cs, true) end)
				card.MouseLeave:Connect(function() glassHover(card, cs, false) end)
				act.InputBegan:Connect(function(i) if isPress(i) then tw(actScale, 0.1, { Scale = 0.94 }) end end)
				act.InputEnded:Connect(function(i) if isPress(i) then tw(actScale, 0.35, { Scale = 1 }, Back) end end)
				act.Activated:Connect(function() if not el.Disabled then spawnSafe(o.Callback, el) end end)
				function el:SetCallback(fn) o.Callback = fn return self end
				return el
			end

			function S:CreateLabel(a, b)
				local _, o = norm(a, b)
				if type(a) == "string" then o = { Title = a } end
				local r = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = nextOrder(), Parent = items }, { pad(SP.Gap, SP.Text, SP.Gap, SP.Text) })
				local t1 = new("TextLabel", { Text = tostring(o.Title or o.Text or o.Content or ""), TextSize = 13, TextColor3 = T.Sub, TextWrapped = true, RichText = true, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextXAlignment = Enum.TextXAlignment.Left, Parent = r })
				local el = element("Label", nil, r, o, t1, nil)
				el.SetText, el.Set, el.SetContent = el.SetTitle, el.SetTitle, el.SetTitle
				return el
			end
			function S:CreateDivider(text)
				if type(text) == "table" then text = text.Title or text.Text end
				local r = new("Frame", { Size = UDim2.new(1, 0, 0, text and 26 or 12), BackgroundTransparency = 1, LayoutOrder = nextOrder(), Parent = items })
				local line = function(x, w) return new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(x, 0, 0.5, 0), Size = w, BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.93, Parent = r }) end
				if text then
					local tl = new("TextLabel", { Text = tostring(text):upper(), FontFace = body(W_BOLD), TextSize = 11, TextColor3 = T.Muted, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 26), Position = UDim2.fromOffset(10, 0), Parent = r })
					task.defer(function()
						local w = tl.AbsoluteSize.X / (Window._scale or 1)
						line(0, UDim2.new(1, -(w + 28), 0, 1)).Position = UDim2.new(0, w + 18, 0.5, 0)
					end)
				else
					line(0, UDim2.new(1, -20, 0, 1)).Position = UDim2.new(0, 10, 0.5, 0)
				end
				return { Instance = r, Destroy = function() r:Destroy() end, SetVisible = function(_, v) r.Visible = v end }
			end

			for _, n in ipairs({ "Toggle", "Button", "Slider", "Dropdown", "Input", "Keybind", "Colorpicker", "Paragraph", "Label", "Divider", "Image", "Item" }) do
				S["Add" .. n] = S["Create" .. n]
				S[n] = S["Create" .. n]
			end
			S.CreateTextBox, S.AddTextBox, S.TextBox, S.CreateTextbox = S.CreateInput, S.CreateInput, S.CreateInput, S.CreateInput
			S.CreateColorPicker, S.AddColorPicker, S.ColorPicker = S.CreateColorpicker, S.CreateColorpicker, S.CreateColorpicker
			S.CreateBind, S.Bind = S.CreateKeybind, S.CreateKeybind
			return S
		end

		local alt = 0
		function Tab:Left(title) return makeSection(title, "Left") end
		function Tab:Right(title) return makeSection(title, "Right") end
		function Tab:Section(title)
			if type(title) == "table" then
				local side = title.Side
				title = title.Title or title.Name
				if side then return makeSection(title, side) end
			end
			alt += 1
			return makeSection(title, alt % 2 == 1 and "Left" or "Right")
		end
		Tab.CreateSection, Tab.AddSection = Tab.Section, Tab.Section
		Tab.AddLeftSection, Tab.AddRightSection = Tab.Left, Tab.Right

		-- elements made straight on the tab go into one default card
		local default
		setmetatable(Tab, { __index = function(_, k)
			if type(k) == "string" and (k:match("^Create") or k:match("^Add")) then
				return function(_, ...)
					default = default or makeSection(nil, "Left")
					return default[k](default, ...)
				end
			end
		end })

		function Tab:CreateConfigSection(sideName)
			local s = makeSection("Configs", sideName == "Left" and "Left" or "Right")
			local nameBox = s:CreateInput({ Title = "Config name", Placeholder = "my config" })
			local listDrop = s:CreateDropdown({ Title = "Saved", Values = Library:ListConfigs(), Search = true })
			s:CreateButton({ Title = "Save config", Icon = "save", Style = "Primary", Callback = function()
				local name = (nameBox.Value ~= "" and nameBox.Value) or listDrop.Value
				if not name or name == "" then return Library:Notify({ Title = "Name needed", Content = "Type a config name, then save again.", Type = "Warning" }) end
				local ok, err = Library:SaveConfig(name)
				Library:Notify(ok and { Title = "Config saved", Content = "Saved as " .. name .. ". Load it from the list, or turn on Auto load to apply it on start.", Type = "Success" }
					or { Title = "Save failed", Content = tostring(err), Type = "Error" })
				listDrop:SetValues(Library:ListConfigs())
				listDrop:SetValue(name, true)
			end })
			s:CreateButton({ Title = "Load config", Icon = "download", Callback = function()
				if not listDrop.Value then return Library:Notify({ Title = "No config selected", Content = "Pick one in the Saved list, then load it.", Type = "Warning" }) end
				local ok, err = Library:LoadConfig(listDrop.Value)
				Library:Notify(ok and { Title = "Config loaded", Content = listDrop.Value .. " is applied: every setting it saved is back.", Type = "Success" }
					or { Title = "Load failed", Content = tostring(err), Type = "Error" })
			end })
			s:CreateButton({ Title = "Delete config", Icon = "trash-2", Callback = function()
				local name = listDrop.Value
				if not name then return end
				Window:Dialog({ Title = "Delete " .. name .. "?", Content = "This config file is removed for good.", Buttons = {
					{ Title = "Delete", Callback = function()
						Library:DeleteConfig(name)
						listDrop:SetValues(Library:ListConfigs())
					end },
					{ Title = "Cancel" },
				} })
			end })
			s:CreateButton({ Title = "Refresh list", Icon = "refresh-cw", Callback = function() listDrop:SetValues(Library:ListConfigs()) end })
			local auto = s:CreateToggle({ Title = "Auto load", Description = "Loads the selected config on start", Default = Library:GetAutoload() ~= nil })
			auto:OnChanged(function(v)
				if v and listDrop.Value then Library:SetAutoload(listDrop.Value)
				elseif not v then Library:SetAutoload(nil) end
			end)
			task.delay(0.6, function()
				local name = Library:GetAutoload()
				if name and not Library._autoloaded then
					Library._autoloaded = true
					listDrop:SetValue(name, true)
					local ok = Library:LoadConfig(name)
					if ok then Library:Notify({ Title = "Config auto loaded", Content = name .. " was applied on start.", Type = "Success", Duration = 4 }) end
				end
			end)
			return s
		end
		Tab.AddConfigSection = Tab.CreateConfigSection

		table.insert(Window._order, Tab)
		Window.Tabs[Tab.Title] = Tab
		if not current and opts.AutoSelect ~= false then task.defer(function() if not current then selectTab(Tab) end end) end
		return Tab
	end
	Window.AddTab, Window.Tab = Window.CreateTab, Window.CreateTab

	function Window:SelectTab(i)
		local tab = type(i) == "number" and Window._order[i] or type(i) == "string" and Window.Tabs[i] or (type(i) == "table" and i)
		if tab then selectTab(tab) end
	end

	-- Command palette
	local paletteOpen = false
	local function openPalette()
		if paletteOpen then return end
		paletteOpen = true
		local dim = new("TextButton", { Text = "", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, ZIndex = 70, Parent = overlay }, { corner(R.Window) })
		tw(dim, 0.25, { BackgroundTransparency = 0.45 })
		local w = math.min(440, root.Size.X.Offset - 32)
		local card = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, TOP_H - 6), Size = UDim2.fromOffset(w, 52), ClipsDescendants = true, ZIndex = 71, Parent = dim })
		darkGlass(card, R.Panel, 0.05)
		tw(card, 0.4, { Position = UDim2.new(0.5, 0, 0, TOP_H + 8) }, Back)
		local box = new("TextBox", { Text = "", PlaceholderText = "Search features", PlaceholderColor3 = T.Muted, TextSize = 15, ClearTextOnFocus = false, Position = UDim2.fromOffset(42, 0), Size = UDim2.new(1, -54, 0, 52), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 72, Parent = card })
		icon(card, "search", 18, T.Muted, { Position = UDim2.fromOffset(15, 17), ZIndex = 72 })
		local results = new("ScrollingFrame", { Position = UDim2.fromOffset(6, 52), Size = UDim2.new(1, -12, 1, -58), BackgroundTransparency = 1, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 2, ZIndex = 72, Parent = card }, { vlist(2) })
		local sep = new("Frame", { Position = UDim2.fromOffset(0, 52), Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.93, ZIndex = 72, Parent = card })
		local kindIcon = { Toggle = "toggle-right", Slider = "sliders-horizontal", Dropdown = "list", Button = "mouse-pointer-click", Input = "keyboard", Keybind = "keyboard", Colorpicker = "palette", Paragraph = "info", Label = "info" }
		local closed = false
		local function close()
			if closed then return end
			closed = true
			paletteOpen = false
			tw(dim, 0.2, { BackgroundTransparency = 1 })
			tw(card, 0.2, { Position = UDim2.new(0.5, 0, 0, TOP_H - 6) })
			card.Visible = false
			task.delay(0.22, function() dim:Destroy() end)
		end
		local function jump(entry)
			close()
			selectTab(entry.Tab)
			if entry.Tab._ensure and entry.Card then entry.Tab._ensure(entry.Card) end
			task.delay(0.08, function()
				if not entry.Row.Parent then return end
				local pg = entry.Tab.Page
				local y = (entry.Row.AbsolutePosition.Y - pg.AbsolutePosition.Y) / (Window._scale or 1) + pg.CanvasPosition.Y - 40
				tw(pg, 0.5, { CanvasPosition = Vector2.new(0, math.max(0, y)) })
				local flash = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = T.Accent, BackgroundTransparency = 0.7, ZIndex = 0, Parent = entry.Row }, { corner(R.Control) })
				task.delay(0.35, function()
					tw(flash, 0.9, { BackgroundTransparency = 1 })
					task.delay(0.95, function() flash:Destroy() end)
				end)
			end)
		end
		local first
		local function refresh()
			for _, c in ipairs(results:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
			local q = box.Text:lower()
			local n = 0
			first = nil
			if q ~= "" then
				for _, e in ipairs(Window._search) do
					if e.Row.Parent and e.Title:lower():find(q, 1, true) then
						n += 1
						if n > 40 then break end
						first = first or e
						local rb = new("TextButton", { Text = "", Size = UDim2.new(1, -4, 0, 34), BackgroundColor3 = WHITE, BackgroundTransparency = n == 1 and 0.94 or 1, LayoutOrder = n, ZIndex = 73, Parent = results }, { corner(R.Control) })
						icon(rb, kindIcon[e.Kind] or "circle", 15, T.Accent2, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), ZIndex = 74 })
						new("TextLabel", { Text = e.Title, TextSize = 14, Position = UDim2.fromOffset(34, 0), Size = UDim2.new(1, -130, 1, 0), TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 74, Parent = rb })
						new("TextLabel", { Text = e.Tab.Title, TextSize = 12, TextColor3 = T.Muted, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 0), Size = UDim2.new(0, 90, 1, 0), TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 74, Parent = rb })
						rb.MouseEnter:Connect(function() tw(rb, 0.15, { BackgroundTransparency = 0.94 }) end)
						rb.MouseLeave:Connect(function() tw(rb, 0.15, { BackgroundTransparency = 1 }) end)
						rb.Activated:Connect(function() jump(e) end)
					end
				end
			end
			local h = q == "" and 52 or (58 + math.max(1, math.min(n, 6)) * 38 + 4)
			if q ~= "" and n == 0 then
				new("TextLabel", { Text = "No feature matches \"" .. box.Text .. "\"", TextSize = 13, TextColor3 = T.Muted, Size = UDim2.new(1, 0, 0, 36), ZIndex = 74, Parent = results })
			end
			sep.Visible = false
			tw(card, 0.3, { Size = UDim2.fromOffset(w, h) })
		end
		box:GetPropertyChangedSignal("Text"):Connect(refresh)
		box.FocusLost:Connect(function(enter) if enter and first then jump(first) end end)
		dim.Activated:Connect(close)
		task.defer(function() box:CaptureFocus() end)
	end
	Window.OpenSearch = openPalette
	searchBtn.Activated:Connect(openPalette)
	on(UserInputService.InputBegan, function(input, processed)
		if processed or not Window.Visible then return end
		if input.KeyCode == Enum.KeyCode.K and (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)) then
			openPalette()
		end
	end)

	function Window:Unload() return Library:Unload() end
	Window.Destroy, Window.Close = Window.Unload, Window.Unload
	function Window:SetTitle(s)
		titleText = tostring(s)
		first, last = titleText:match("^(.-)%s+(%S+)$")
		renderTitle()
	end

	-- Build-up on open
	local buildToken = 0
	local wraps = {}
	local function topItems()
		local list = { brandLogo, titleLabel, pageTitle }
		if subLabel then table.insert(list, subLabel) end
		for _, c in ipairs(controls:GetDescendants()) do if c:IsA("ImageLabel") then table.insert(list, c) end end
		return list
	end
	local function fadeProp(o)
		if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then return "TextTransparency" end
		if o:IsA("ImageLabel") or o:IsA("ImageButton") then return "ImageTransparency" end
	end
	local function glassRest(obj, level)
		return 1 - level[1], level[2]
	end
	local function unwrapAll()
		for _, w in ipairs(wraps) do
			if w.items.Parent == w.cg then w.items.Parent = w.card end
			w.cg:Destroy()
		end
		table.clear(wraps)
	end
	local function finishBuild()
		buildToken += 1
		unwrapAll()
		for _, o in ipairs(topItems()) do local p = fadeProp(o) if p then o[p] = 0 end end
		local bt, st = glassRest(side, GL.Panel)
		side.BackgroundTransparency = bt
		local ss = side:FindFirstChildOfClass("UIStroke")
		if ss then ss.Transparency = st end
		for _, t in ipairs(Window._order) do
			t.IconImg.ImageTransparency = 0
			if t.Label then t.Label.TextTransparency = 0 t.Label.Position = UDim2.fromOffset(36, 0) end
			for _, card in ipairs(t._cards) do
				card.BackgroundTransparency = bt
				local cs = card:FindFirstChildOfClass("UIStroke")
				if cs then cs.Transparency = st end
			end
		end
		for _, d in ipairs(userCard:GetDescendants()) do local p = fadeProp(d) if p then d[p] = 0 end end
		if Window._current then
			indicator.BackgroundTransparency, indStroke.Transparency = 1 - GL.Control[1], GL.Control[2]
		end
	end
	Window._finishBuild = finishBuild

	-- hide every piece, before the window frame fades in
	function Window._prebuild()
		finishBuild()
		local token = buildToken
		for _, o in ipairs(topItems()) do local p = fadeProp(o) if p then o[p] = 1 end end
		side.BackgroundTransparency = 1
		local ss = side:FindFirstChildOfClass("UIStroke")
		if ss then ss.Transparency = 1 end
		for _, t in ipairs(Window._order) do
			t.IconImg.ImageTransparency = 1
			if t.Label then t.Label.TextTransparency = 1 t.Label.Position = UDim2.fromOffset(28, 0) end
		end
		indicator.BackgroundTransparency, indStroke.Transparency = 1, 1
		for _, d in ipairs(userCard:GetDescendants()) do local p = fadeProp(d) if p then d[p] = 1 end end
		local tab = Window._current
		if tab then
			local pg = tab.Page
			local top, bottom = pg.AbsolutePosition.Y, pg.AbsolutePosition.Y + pg.AbsoluteSize.Y
			local picked = 0
			for _, card in ipairs(tab._cards) do
				local onScreen = card.AbsolutePosition.Y < bottom and card.AbsolutePosition.Y + card.AbsoluteSize.Y > top
				if card.Parent and card.Visible and onScreen and picked < 8 and card:FindFirstChildOfClass("Frame") then
					picked += 1
					card.BackgroundTransparency = 1
					local cs = card:FindFirstChildOfClass("UIStroke")
					if cs then cs.Transparency = 1 end
					local items = card:FindFirstChildOfClass("Frame")
					if items then
						local cg = new("CanvasGroup", { Name = "Build", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, GroupTransparency = 1, Parent = card })
						items.Parent = cg
						table.insert(wraps, { card = card, items = items, cg = cg })
					end
				end
			end
		end
		return token
	end

	-- play the build; `t0` lets the window frame land first
	function Window._build(t0)
		local token = buildToken
		local function alive() return token == buildToken end
		local function at(t, fn) task.delay(t0 + t, function() if alive() then fn() end end) end
		local bt, st = glassRest(side, GL.Panel)
		-- header
		at(0, function()
			for i, o in ipairs(topItems()) do
				local p = fadeProp(o)
				if p then task.delay(i * 0.02, function() if alive() then tw(o, 0.25, { [p] = 0 }) end end) end
			end
		end)
		-- sidebar panel draws its outline, then fills
		at(0.04, function()
			local ss = side:FindFirstChildOfClass("UIStroke")
			if ss then tw(ss, 0.2, { Transparency = st }) end
			tw(side, 0.3, { BackgroundTransparency = bt })
		end)
		-- tabs arrive one by one, sliding in from the left
		at(0.08, function()
			for i, t in ipairs(Window._order) do
				task.delay((i - 1) * 0.028, function()
					if not alive() then return end
					tw(t.IconImg, 0.22, { ImageTransparency = 0 })
					if t.Label then tw(t.Label, 0.3, { TextTransparency = 0, Position = UDim2.fromOffset(36, 0) }, Quint) end
					if t == Window._current then
						tw(indicator, 0.25, { BackgroundTransparency = 1 - GL.Control[1] })
						tw(indStroke, 0.25, { Transparency = GL.Control[2] })
					end
				end)
			end
		end)
		-- cards cascade: outline, glass, content
		at(0.12, function()
			for i, w in ipairs(wraps) do
				task.delay((i - 1) * 0.06, function()
					if not alive() then return end
					local cs = w.card:FindFirstChildOfClass("UIStroke")
					if cs then tw(cs, 0.18, { Transparency = st }) end
					tw(w.card, 0.3, { BackgroundTransparency = bt })
					task.delay(0.07, function()
						if not alive() then return end
						tw(w.cg, 0.26, { GroupTransparency = 0 }, Quint)
					end)
				end)
			end
		end)
		-- profile last
		at(0.26, function()
			for _, d in ipairs(userCard:GetDescendants()) do
				local p = fadeProp(d)
				if p then tw(d, 0.25, { [p] = 0 }) end
			end
		end)
		-- hand the card content back to the cards once everything is in
		at(0.12 + #wraps * 0.06 + 0.45, function() unwrapAll() end)
	end

	-- Splash, then the window opens
	local function reveal() setVisible(true) end
	if opts.Splash == false then
		task.defer(reveal)
	else
		local sp = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, ZIndex = 200, Parent = Screen })
		tw(sp, 0.4, { BackgroundTransparency = 0.35 })
		local box = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(300, 220), BackgroundTransparency = 1, ZIndex = 201, Parent = sp })
		local bscale = new("UIScale", { Scale = 0.85, Parent = box })
		tw(bscale, 0.7, { Scale = math.min(1, viewport().Y / 420) }, Back)
		local tileF = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 58), Size = UDim2.fromOffset(92, 92), ZIndex = 202, Parent = box })
		darkGlass(tileF, 18, 0.1, 0.4)
		local tscale = new("UIScale", { Scale = 0.6, Parent = tileF })
		tw(tscale, 0.7, { Scale = 1 }, Back)
		local splashLogo = logo(box, 56, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 58), ZIndex = 203 })
		local lscale = new("UIScale", { Scale = 0.3, Parent = splashLogo })
		tw(lscale, 0.8, { Scale = 1 }, Back)
		local name = new("TextLabel", { RichText = true, FontFace = head(W_BOLD), TextSize = 26, Position = UDim2.fromOffset(0, 124), Size = UDim2.new(1, 0, 0, 32), TextTransparency = 1, ZIndex = 202, Parent = box })
		name.Text = first and string.format('%s <font color="%s">%s</font>', first, hex(T.Accent2), last) or titleText
		local sub = new("TextLabel", { Text = tostring(opts.SubTitle or "Loading"), TextSize = 13, TextColor3 = T.Sub, Position = UDim2.fromOffset(0, 158), Size = UDim2.new(1, 0, 0, 18), TextTransparency = 1, ZIndex = 202, Parent = box })
		local barBg = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 190), Size = UDim2.fromOffset(140, 3), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.9, ZIndex = 202, Parent = box }, { corner(2) })
		local barFill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 203, Parent = barBg }, { corner(2) })
		paint(gradient({ Parent = barFill }), "Color", "seq")
		task.delay(0.25, function()
			name.Position = UDim2.fromOffset(0, 134)
			tw(name, 0.6, { TextTransparency = 0, Position = UDim2.fromOffset(0, 124) })
			task.delay(0.12, function() tw(sub, 0.6, { TextTransparency = 0 }) end)
		end)
		tw(barFill, 1.5, { Size = UDim2.fromScale(1, 1) }, Sine, Enum.EasingDirection.InOut)
		local stop = animate(function(t)
			tileF.Position = UDim2.new(0.5, 0, 0, 58 + math.sin(t * 3) * 2)
			splashLogo.Position = UDim2.new(0.5, 0, 0, 58 + math.sin(t * 3) * 2)
		end)
		task.delay(1.75, function()
			tw(sp, 0.45, { BackgroundTransparency = 1 })
			tw(bscale, 0.45, { Scale = 1.08 }, Quint, Enum.EasingDirection.In)
			for _, d in ipairs(box:GetDescendants()) do
				if d:IsA("TextLabel") then tw(d, 0.3, { TextTransparency = 1 })
				elseif d:IsA("ImageLabel") then tw(d, 0.3, { ImageTransparency = 1 })
				elseif d:IsA("UIStroke") then tw(d, 0.3, { Transparency = 1 })
				elseif d:IsA("Frame") then tw(d, 0.3, { BackgroundTransparency = 1 }) end
			end
			task.delay(0.15, reveal)
			task.delay(0.5, function() stop() sp:Destroy() end)
		end)
	end

	Window.SetAccent = function(_, c) Library:SetAccent(c) end
	return Window
end
Library.AddWindow = Library.CreateWindow

-- Accent
function Library:SetAccent(c)
	local h, s, v = c:ToHSV()
	T.Accent = c
	T.Accent2 = Color3.fromHSV(h, math.max(0, s - 0.35), math.min(1, v + 0.12))
	T.AccentDeep = Color3.fromHSV(h, math.min(1, s + 0.1), math.max(0, v - 0.18))
	for i = #accentPaint, 1, -1 do
		local p = accentPaint[i]
		if p[1].Parent == nil and not p[1]:IsDescendantOf(game) then
			table.remove(accentPaint, i)
		else
			pcall(function()
				if p[2] == "ImageColor3" and p[1]:GetAttribute("AxonKeepColor") then return end
				if p[3] == "seq" then p[1][p[2]] = accentSeq()
				elseif p[3] == "light" then p[1][p[2]] = T.Accent2
				else p[1][p[2]] = T.Accent end
			end)
		end
	end
end

-- Configs
local function configDir()
	local dir = Library.Folder .. "/configs/" .. tostring(game.PlaceId)
	ensureFolder(Library.Folder)
	ensureFolder(Library.Folder .. "/configs")
	ensureFolder(dir)
	return dir
end
function Library:ListConfigs()
	local out = {}
	pcall(function()
		for _, f in ipairs(listfiles(configDir())) do
			local n = tostring(f):match("([^/\\]+)%.json$")
			if n then table.insert(out, n) end
		end
	end)
	table.sort(out)
	return out
end
function Library:SaveConfig(name)
	if not writefile then return false, "This executor cannot write files, so configs cannot be saved here." end
	name = tostring(name):gsub("[^%w%s_%-]", "")
	local data = {}
	for flag, el in pairs(self.Options) do
		if el._serialize then
			local ok, v = pcall(el._serialize, el)
			if ok then data[flag] = v end
		end
	end
	local ok, err = pcall(function() writefile(configDir() .. "/" .. name .. ".json", HttpService:JSONEncode(data)) end)
	return ok, err
end
function Library:LoadConfig(name)
	if not readfile then return false, "This executor cannot read files, so configs cannot be loaded here." end
	local path = configDir() .. "/" .. tostring(name) .. ".json"
	local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
	if not ok or type(data) ~= "table" then return false, "That config file is missing or damaged. Save it again to replace it." end
	for flag, v in pairs(data) do
		local el = self.Options[flag]
		if el and el._deserialize then pcall(el._deserialize, el, v) end
	end
	return true
end
function Library:DeleteConfig(name)
	return pcall(function() delfile(configDir() .. "/" .. tostring(name) .. ".json") end)
end
function Library:SetAutoload(name)
	pcall(function()
		local p = configDir() .. "/autoload.txt"
		if name then writefile(p, tostring(name)) elseif isfile(p) then delfile(p) end
	end)
end
function Library:GetAutoload()
	local name
	pcall(function()
		local p = configDir() .. "/autoload.txt"
		if isfile(p) then name = readfile(p) end
	end)
	return (name and name ~= "") and name or nil
end

-- Unload
function Library:Unload(quiet)
	if self.Unloaded then return end
	self.Unloaded = true
	for _, el in pairs(self.Options) do
		if el.Type == "Toggle" and el.Value then
			el.Value = false
			safe(el._callback, false)
		end
	end
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	table.clear(animators)
	table.clear(binds)
	local win = self.Window
	if win and win._blur then
		local b = win._blur
		pcall(function() tw(b, 0.25, { Size = 0 }) end)
		task.delay(quiet and 0 or 0.3, function() pcall(function() b:Destroy() end) end)
	end
	if win and win.Root and not quiet then
		pcall(function()
			local s = win.Root:FindFirstChildOfClass("UIScale")
			tw(s, 0.25, { Scale = s.Scale * 0.9 }, Quint, Enum.EasingDirection.In)
		end)
		task.delay(0.22, function() Screen:Destroy() end)
	else
		Screen:Destroy()
	end
	self.OnUnload:Fire()
	if genv.__AxonHub == self then genv.__AxonHub = nil end
end
Library.Destroy = Library.Unload

return Library
