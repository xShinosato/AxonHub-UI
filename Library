local Quint, Quad, Back, Sine, Expo = Enum.EasingStyle.Quint, Enum.EasingStyle.Quad, Enum.EasingStyle.Back, Enum.EasingStyle.Sine, Enum.EasingStyle.Exponential
local function tw(obj, t, props, style, dir)
	if props.ImageColor3 and obj:GetAttribute("AxonKeepColor") then
		local copy = table.clone(props)
		copy.ImageColor3 = nil
		props = copy
	end
	local tween = TweenService:Create(obj, TweenInfo.new(t or 0.25, style or Quint, dir or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

local function new(class, props, children)
	local o = Instance.new(class)
	if o:IsA("GuiObject") then o.BorderSizePixel = 0 end
	if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
		o.FontFace = body()
		o.TextColor3 = T.Text
		o.TextSize = 14
		o.BackgroundTransparency = 1
		if o:IsA("TextButton") then o.AutoButtonColor = false end
		-- a button or box given a colour is meant to show it
		if props and props.BackgroundColor3 and props.BackgroundTransparency == nil and not o:IsA("TextLabel") then
			o.BackgroundTransparency = 0
		end
	elseif o:IsA("ImageLabel") or o:IsA("ImageButton") then
		o.BackgroundTransparency = 1
		if o:IsA("ImageButton") then o.AutoButtonColor = false end
	end
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then parent = v else o[k] = v end
	end
	for _, c in ipairs(children or {}) do c.Parent = o end
	if parent then o.Parent = parent end
	return o
end

