			local here = d.JobId and d.JobId == game.JobId
			local join = new("TextButton", { Text = "", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -9, 0.5, 0), Size = UDim2.fromOffset(joinW, 30), BackgroundTransparency = 1, ZIndex = 59, Parent = f })
