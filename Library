	-- Server browser
	do
		local SB = { title = "Servers", cards = {}, sort = "Most", refresh = nil, open = false, loading = false }
		Window.Servers = SB.cards
		local dock, sheet, list, subLabel, refreshIc, emptyState, skeleton, chips = nil, nil, nil, nil, nil, nil, nil, {}
		local function count() local n = 0 for _ in ipairs(SB.cards) do n += 1 end return n end
		local function setSub(text) if subLabel then subLabel.Text = text end end
		local function summary()
			local n = count()
			setSub(n == 0 and "No servers listed" or (n == 1 and "1 server" or (n .. " servers")))
		end

		local function sortCards()
			local key = SB.sort
			local ordered = table.clone(SB.cards)
			table.sort(ordered, function(a, b)
				local x, y = a.data, b.data
				if key == "Ping" then return (tonumber(x.Ping) or 1e9) < (tonumber(y.Ping) or 1e9) end
				local px, py = tonumber(x.Players) or -1, tonumber(y.Players) or -1
				if px == py then return a.order < b.order end
				if key == "Fewest" then return px < py end
				return px > py
			end)
			for i, c in ipairs(ordered) do if c.frame then c.frame.LayoutOrder = i end end
		end

		local function showEmpty()
			if not emptyState then return end
			emptyState.Visible = count() == 0 and not SB.loading
			skeleton.Visible = SB.loading and count() == 0
		end

		local function buildCard(c)
