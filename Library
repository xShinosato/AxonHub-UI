			Parent = content,
		})
		paint(page, "ScrollBarImageColor3")
		local cols = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = page }, {
			hlist(SP.Group, Enum.VerticalAlignment.Top),
			pad(Window._bleed, 6, Window._bleed, Window._bleed),
		})
		local function column(order)
			return new("Frame", { Size = UDim2.new(0.5, -SP.Group / 2, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = order, Parent = cols }, { vlist(SP.Group) })
		end
		local leftCol = column(1)
		local rightCol = column(2)
		local single = false
		local function reflow(v)
			single = v
			leftCol.Size = v and UDim2.new(1, 0, 0, 0) or UDim2.new(0.5, -SP.Group / 2, 0, 0)
			rightCol.Visible = not v
			for _, card in ipairs(Tab._cards) do
				if card.Parent then
					local home = card:GetAttribute("Side") == "Right" and rightCol or leftCol
					card.Parent = v and leftCol or home
				end
			end
		end
		table.insert(reflowHooks, function(v) reflow(v) if Tab._cull then task.defer(Tab._cull, true) end end)
		reflow(L_.single)
		Tab.Page = page

		-- Performance
		Tab._fx = {}
		Tab._cardInfo = {}
		local CULL_MARGIN = 1
		local ATTACH_PER_FRAME = 3
		local function cardVisibleRange()
			local s = math.max(0.01, scale.Scale)
			local viewH = page.AbsoluteSize.Y / s
			return -viewH * CULL_MARGIN, viewH * (1 + CULL_MARGIN), s
		end
		local function setAttached(info, attach)
			if info.attached == attach then return end
			local card, items = info.card, info.items
			if not attach then
				-- never detach what the user is working in
				local focused = UserInputService:GetFocusedTextBox()
				if focused and focused:IsDescendantOf(items) then return end
				if info.S._busy then return end
				local h = card.AbsoluteSize.Y / math.max(0.01, scale.Scale)
				if h <= 0 then return end
				card.AutomaticSize = Enum.AutomaticSize.None
				card.Size = UDim2.new(1, 0, 0, math.floor(h + 0.5))
				items.Parent = nil
				info.attached = false
				info.S._culled = true
			else
				items.Parent = card
				card.Size = UDim2.new(1, 0, 0, 0)
				card.AutomaticSize = Enum.AutomaticSize.Y
				info.attached = true
				info.S._culled = false
			end
		end
		Tab._setAttached = setAttached
		local lastCullY
		local function cull(force)
			if current ~= Tab then
				-- a hidden page keeps nothing attached
				for _, info in ipairs(Tab._cardInfo) do setAttached(info, false) end
				return
			end
			local y = page.CanvasPosition.Y
			if not force and lastCullY and math.abs(y - lastCullY) < page.AbsoluteSize.Y * 0.25 then return end
			lastCullY = y
			local top, bottom, s = cardVisibleRange()
			local pageY = page.AbsolutePosition.Y
			local viewH = page.AbsoluteSize.Y / s
			local want = {}
			for _, info in ipairs(Tab._cardInfo) do
				if info.card.Parent then
					local cy = (info.card.AbsolutePosition.Y - pageY) / s
					local ch = info.card.AbsoluteSize.Y / s
					if cy + ch >= top and cy <= bottom then
						if not info.attached then
							-- distance from the view: cards on screen come first
							info._dist = (cy + ch < 0 and -(cy + ch)) or (cy > viewH and cy - viewH) or 0
							table.insert(want, info)
						end
					else
						setAttached(info, false) -- cheap, done at once
					end
				end
			end
			table.sort(want, function(a, b) return a._dist < b._dist end)
			Tab._attachQueue = want
			if #want > 0 and not Tab._attaching then
				Tab._attaching = true
				task.spawn(function()
					while Tab._attachQueue and #Tab._attachQueue > 0 and current == Tab do
						for _ = 1, ATTACH_PER_FRAME do
							local info = table.remove(Tab._attachQueue, 1)
							if not info then break end
							if info.card.Parent then setAttached(info, true) end
						end
						RunService.Heartbeat:Wait()
					end
					Tab._attaching = false
				end)
			end
		end
		Tab._cull = cull
		local cullPending = false
		local function scheduleCull()
			if cullPending then return end
			cullPending = true
			task.spawn(function()
				RunService.Heartbeat:Wait()
				RunService.Heartbeat:Wait()
				cullPending = false
				cull(true)
			end)
		end
		Tab._scheduleCull = scheduleCull
		page:GetPropertyChangedSignal("CanvasPosition"):Connect(function() cull(false) end)
		page:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() task.defer(cull, true) end)
		-- make sure one card is attached (search jumps, scroll-to)
		function Tab._attachVisibleNow()
			if not Tab._attachQueue then return end
			local s = math.max(0.01, scale.Scale)
			local viewH = page.AbsoluteSize.Y / s
			for i = #Tab._attachQueue, 1, -1 do
				local info = Tab._attachQueue[i]
				if info._dist == 0 then setAttached(info, true) table.remove(Tab._attachQueue, i) end
			end
		end
		function Tab._ensure(card)
			for _, info in ipairs(Tab._cardInfo) do if info.card == card then setAttached(info, true) end end
		end

		function Tab:Select() selectTab(Tab) end
		function Tab:SetTitle(s) Tab.Title = tostring(s) if label then label.Text = Tab.Title end if current == Tab then pageTitle.Text = Tab.Title end end

		-- Sections
		local function makeSection(title, sideName)
			Tab._count += 1
			local parentCol = (sideName == "Right" and not single) and rightCol or leftCol
			local card = new("Frame", {
				Name = tostring(title or "Section"), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
				LayoutOrder = Tab._count, Parent = parentCol,
			}, { pad(SP.Card) })
			card:SetAttribute("Side", sideName == "Right" and "Right" or "Left")
			panelGlass(card)
			local items = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Parent = card }, { vlist(SP.Item) })
			table.insert(Tab._cards, card)
			if current == Tab then empty.Visible = false end

			local S = { Type = "Section", Instance = card, Tab = Tab, _n = 1 }
			local cardInfo = { card = card, items = items, S = S, attached = true }
			table.insert(Tab._cardInfo, cardInfo)
			scheduleCull()
			-- control animations of this card, run by the page loop
			local function addFx(fn)
				local e = { fn = fn, S = S }
				table.insert(Tab._fx, e)
				return function() table.remove(Tab._fx, table.find(Tab._fx, e) or 0) end
			end
			if title and title ~= "" then
				-- header: title on the row text line, a hairline, then the rows
				local header = new("Frame", { Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1, LayoutOrder = 0, Parent = items })
				S._titleLabel = new("TextLabel", { Text = tostring(title), FontFace = head(W_SEMI), TextSize = 13, Position = UDim2.fromOffset(SP.Text, 0), Size = UDim2.new(1, -SP.Text * 2, 1, -1), TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Parent = header })
				new("Frame", { Size = UDim2.new(1, 0, 0, SP.Item), BackgroundTransparency = 1, LayoutOrder = 0, Parent = items })
			end
			function S:SetTitle(s) if S._titleLabel then S._titleLabel.Text = tostring(s) end end
			function S:SetVisible(v) card.Visible = v and true or false end
			function S:Destroy()
				card:Destroy()
				table.remove(Tab._cards, table.find(Tab._cards, card) or 0)
				table.remove(Tab._cardInfo, table.find(Tab._cardInfo, cardInfo) or 0)
				for i = #Tab._fx, 1, -1 do if Tab._fx[i].S == S then table.remove(Tab._fx, i) end end
			end

			local function nextOrder() S._n += 1 return S._n end

			-- row: the base every element sits on -----------------------
			local function row(h, clickable)
				local r = new(clickable and "TextButton" or "Frame", {
					Size = UDim2.new(1, 0, 0, h), BackgroundColor3 = WHITE, BackgroundTransparency = 1,
					LayoutOrder = nextOrder(), Parent = items,
				}, { corner(R.Control) })
				if clickable then r.Text = "" end
				r.MouseEnter:Connect(function() tw(r, 0.2, { BackgroundTransparency = 0.965 }) end)
				r.MouseLeave:Connect(function() tw(r, 0.25, { BackgroundTransparency = 1 }) end)
				return r
			end
			local function setThumb(tile, src)
				local pic = tile and tile:FindFirstChild("Pic")
				if not pic then return end
				setIcon(pic, src)
				local isPic = pic:GetAttribute("AxonKeepColor") == true
