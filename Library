			indicator.BackgroundTransparency = on_
			indStroke.Transparency = GL.Control[2]
		else
			tw(indicator, 0.45, { Position = UDim2.fromOffset(0, y), BackgroundTransparency = on_ }, Quint)
			tw(indStroke, 0.3, { Transparency = GL.Control[2] })
