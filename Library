		function Window:LoadServers(o)
			o = o or {}
			local placeId = o.PlaceId or game.PlaceId
			local pages = o.Pages or 2
			local image = o.Image or Library:Thumbnail("Game", game.GameId)
			local found, cursor = {}, ""
			for _ = 1, pages do
				local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Desc&excludeFullGames=%s&limit=100%s"):format(
					placeId, o.IncludeFull and "false" or "true", cursor ~= "" and ("&cursor=" .. cursor) or "")
				local ok, body_ = pcall(function() return game:HttpGet(url) end)
				if not ok then error("The server list could not be reached.", 0) end
				local okJ, data = pcall(function() return HttpService:JSONDecode(body_) end)
				if not okJ or type(data) ~= "table" or type(data.data) ~= "table" then
					if #found > 0 then break end
					error("Roblox is limiting server lists right now. Try again in a minute.", 0)
				end
				for _, sv in ipairs(data.data) do table.insert(found, sv) end
				cursor = data.nextPageCursor
				if not cursor or cursor == "" then break end
			end
			Window:ClearServers()
			local TeleportService = game:GetService("TeleportService")
			for i, sv in ipairs(found) do
				if i > (o.Limit or 40) then break end
				local playing, maxP = tonumber(sv.playing) or 0, tonumber(sv.maxPlayers) or 0
				local ping = tonumber(sv.ping)
				local here = sv.id == game.JobId
				Window:AddServer({
					Image = image, JobId = sv.id, Players = playing, MaxPlayers = maxP, Ping = ping,
					Title = ("%d / %d players"):format(playing, maxP),
					Description = (here and "Your server · " or "") .. (ping and ("Ping " .. ping .. " ms") or "Ping unknown"),
					Callback = function() TeleportService:TeleportToPlaceInstance(placeId, sv.id, LocalPlayer) end,
				})
			end
			return #found
		end
