				r.MouseLeave:Connect(function() tw(r, 0.25, { BackgroundTransparency = 1 }) glassHover(valuePill, pillStroke, false) end)
				local t1, t2 = titled(r, o, 150)
				fitTitle(t1, t2, valuePill)
				local valueText = marquee(valuePill, { Height = PILL, TextSize = 13, Color = T.Sub, MaxWidth = 116, Register = addFx },
					function() return Window._scale or 1 end,
					function() return root.Visible and valuePill.AbsoluteSize.X > 0 end)
				local function capPill()
					local s = Window._scale or 1
					local m = math.max(60, math.floor(r.AbsoluteSize.X / s * 0.55))
					valueText:SetMaxWidth(m - (10 + 8 + 6 + 14))
