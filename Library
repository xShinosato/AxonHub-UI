			local function element(kind, flag, r, o, t1, t2)
				if not cardInfo.attached then
					setAttached(cardInfo, true)
				end
				scheduleCull()
				buildYield()
				local el = { Type = kind, Flag = flag, Instance = r, Title = o.Title or o.Name, _changed = {}, Disabled = false }
				function el:OnChanged(fn)
					table.insert(self._changed, fn)
					spawnSafe(fn, self.Value)
					return self
				end
				function el:_fire(v)
					for _, fn in ipairs(self._changed) do spawnSafe(fn, v) end
				end
				function el:SetTitle(s) self.Title = s if t1 then t1.Text = tostring(s) end return self end
				function el:SetImage(v)
					local th = self._thumb or (r and r:FindFirstChild("AxonThumb", true))
					if th then setThumb(th, v) end
					return self
				end
				function el:SetDesc(s) if t2 then t2.Text = tostring(s) end return self end
				el.SetDescription = el.SetDesc
				function el:SetVisible(v) r.Visible = v and true or false return self end
				function el:SetDisabled(v)
					self.Disabled = v and true or false
					for _, d in ipairs(r:GetDescendants()) do
						if d:IsA("TextLabel") or d:IsA("TextBox") then tw(d, 0.2, { TextTransparency = v and 0.55 or 0 }) end
						if d:IsA("ImageLabel") then tw(d, 0.2, { ImageTransparency = v and 0.55 or 0 }) end
					end
					if self._onDisabled then self._onDisabled(self.Disabled) end
					return self
				end
				function el:Destroy()
					if self._dead then return end
					self._dead = true
					if self._cleanup then pcall(self._cleanup) end
					r:Destroy()
					if flag and Library.Options[flag] == self then Library.Options[flag] = nil end
				end
				if flag then Library.Options[flag] = el end
				if o.Disabled then task.defer(function() el:SetDisabled(true) end) end
				table.insert(Window._search, { Title = tostring(o.Title or o.Name or kind), Kind = kind, Tab = Tab, Row = r, Card = card })
				return el
			end

			local function norm(a, b)
