	local function selectTab(tab)
		if L_.nav == "rail" and Window._setDrawer and L_.vis ~= L_.nav then Window._setDrawer(false) end
		if current == tab then return end
		local prev = current
		current = tab
		Window._current = tab
		for _, t in ipairs(Window._order) do
			local active = t == tab
			tw(t.IconImg, 0.25, { ImageColor3 = active and T.Accent2 or T.Muted })
			if t.Label then tw(t.Label, 0.25, { TextColor3 = active and T.Text or T.Sub }) end
			t.Page.Visible = active
		end
		task.defer(moveIndicator, tab, prev == nil)
		task.defer(keepTabInView, tab)
		if tab._cull then task.defer(function() tab._cull(true) tab._attachVisibleNow() end) end
		if prev and prev._cull then task.delay(0.5, function() if current ~= prev then prev._cull(true) end end) end
		-- page motion
		tab.Page.Position = UDim2.fromOffset(0, 16)
		tw(tab.Page, 0.5, { Position = UDim2.fromOffset(0, 0) })
		veil.BackgroundTransparency = 0.3
		tw(veil, 0.4, { BackgroundTransparency = 1 })
		-- title crossfade
		pageTitle.Text = tab.Title
		pageTitle.Position = UDim2.fromOffset(0, 10)
		pageTitle.TextTransparency = 1
		tw(pageTitle, 0.4, { Position = UDim2.fromOffset(0, 0), TextTransparency = 0 })
		local isEmpty = #tab._cards == 0
		empty.Visible = isEmpty
		if isEmpty then
			emptySub.Text = tab.EmptyText or "This tab is waiting for features."
			empty.Position = UDim2.new(0.5, 0, 0.5, 14)
			tw(empty, 0.55, { Position = UDim2.fromScale(0.5, 0.5) }, Back)
		end
	end

