-- Marquee
local MARQUEE_SPEED = 28 -- px per second
local function marquee(parent, props, getScale, isShown)
	local box = new("CanvasGroup", { Name = "Marquee", Size = UDim2.fromOffset(0, props.Height), BackgroundTransparency = 1, LayoutOrder = props.LayoutOrder or 0, Parent = parent })
	local fade = gradient({ Enabled = false, Transparency = NumberSequence.new({ kp(0, 1), kp(0.16, 0), kp(0.84, 0), kp(1, 1) }), Parent = box })
	local strip = new("Frame", { Size = UDim2.fromScale(0, 1), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, Parent = box }, {
		new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local function label(order, parent_)
		return new("TextLabel", { Text = "", TextSize = props.TextSize or 13, TextColor3 = props.Color or T.Sub, FontFace = props.FontFace or body(), Size = UDim2.fromScale(0, 1), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = order, Parent = parent_ or strip })
	end
	local a, b = label(1), label(2)
	b.Visible = false
	local measure = label(0, box)
	measure.TextTransparency = 1
	measure.Position = UDim2.fromOffset(0, -1000)
	local M = { MaxWidth = props.MaxWidth or 120, Scrolling = false }
	local base, sep = "", ", "
	local function fit()
		local s = getScale()
		local textW = measure.AbsoluteSize.X / s
		local scroll = textW > M.MaxWidth + 0.5
		M.Scrolling = scroll
		a.Text = scroll and (base .. sep) or base
		b.Text = base .. sep
		b.Visible, fade.Enabled = scroll, scroll
		box.Size = UDim2.fromOffset(scroll and M.MaxWidth or math.ceil(textW) + 2, props.Height)
		if not scroll then strip.Position = UDim2.new() end
	end
	measure:GetPropertyChangedSignal("AbsoluteSize"):Connect(fit)
	local offset = 0
	local function step(_, dt)
		if not M.Scrolling then return end
		local period = a.AbsoluteSize.X / getScale() -- one copy, separator included
		if period <= 0 then return end
		offset = (offset + dt * MARQUEE_SPEED) % period
		strip.Position = UDim2.fromOffset(-offset, 0)
	end
	if props.Register then
		M._unregister = props.Register(step)
	else
		M._unregister = animate(step, function() return M.Scrolling and box.Parent ~= nil and isShown() end)
	end
	function M:SetText(t, separator)
		separator = separator or sep
		if base == t and sep == separator then return end
		base, sep = t, separator
		measure.Text = t
		offset = 0
		task.defer(fit)
	end
	function M:SetMaxWidth(w)
		if math.abs(self.MaxWidth - w) < 0.5 then return end
		self.MaxWidth = w
		fit()
	end
	function M:TweenColor(c)
		tw(a, 0.2, { TextColor3 = c })
		tw(b, 0.2, { TextColor3 = c })
	end
	M.Instance, M.Labels = box, { a, b }
	return M
end

